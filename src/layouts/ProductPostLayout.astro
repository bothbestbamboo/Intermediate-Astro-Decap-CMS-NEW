---
// ...前面的 import 和 isProductPage 判断保持不变...
---

<BaseLayout title={title} description={description} heroImage={image}>
    <script slot="schema" is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

    <div class={`blog-container ${isProductPage ? "product-page-layout" : "is-blog-post"}`}>
        <div class="blog-wrapper-inner">
            <!-- 左侧内容区 -->
            <section class="main-content">
                <article class="blog-article">
                    <!-- ...header 和图片保持不变... -->
                    <header class="blog-header">
                        <h1 class="blog-h1">{title}</h1>
                        <!-- 作者信息 ... -->
                    </header>
                    <picture class="blog-mainImage">
                        <Image src={image} alt={imageAlt} width="795" height="400" decoding="async" />
                    </picture>

                    <!-- 🌟 移动端 TOC，传入 isProduct -->
                    <div class="cs-hide-on-desktop">
                        <TableOfContents headings={headings} levels={3} isProduct={isProductPage} />
                    </div>
                    <div id="blog-content">
                        <Content />
                    </div>
                </article>
            </section>

            <!-- 右侧边栏 -->
            <aside class="blog-sidebar">
                <!-- 🌟 桌面端 TOC，清空外层的 wrapper 类名，传入 isProduct -->
                <div id="desktop-toc" class="cs-hide-on-mobile">
                    <TableOfContents headings={headings} levels={3} isProduct={isProductPage} />
                </div>

                <!-- 询盘框 -->
                {
                    isProductPage && (
                        <div class="product-inquiry-box-inserted">
                            <!-- ... -->
                        </div>
                    )
                }

                <!-- 推荐文章 -->
                <div class="blog-sidebar_widget-wrapper">
                    <FeaturedProduct />
                </div>
            </aside>
        </div>
    </div>
    <CTA />
</BaseLayout>

<style lang="less" is:global>
    /* ... 前面的基础布局代码保持不变 ... */
    
    /* 确保侧边栏没有多余的 padding 干扰组件 */
    #desktop-toc {
        width: 100%;
        padding: 0;
        margin-bottom: 30px; /* 给下方留点空间 */
    }

    /* ... 其他样式 ... */
</style>