---
// Utils
import { render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { formatDate } from "@js/utils";

// 🌟 引入两个 Schema 工具函数
import { getBlogPostingSchema } from "@js/blogPostingSchema.js";
import { getProductSchema } from "@js/productSchema.js"; 

import "@styles/markdown.less";
import xcBathAvatar from "@assets/images/authors/xcbath.png";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import FeaturedProduct from "@components/FeaturedProduct/FeaturedProduct.astro";
import TableOfContents from "@components/TableOfContents/TableOfContents.astro";
import CTA from "@components/CTA/CTASimple.astro";
import ImageLightbox from "@components/Lightbox/ImageLightbox.astro";

const { post } = Astro.props;
const { title, date, description, image, imageAlt, author, tags, reviews } = post.data;
const { Content, headings } = await render(post);

// 🌟 修复核心：将 tags 全部转为小写进行匹配，避免大小写导致的判断失败
const lowerTags = tags ? tags.map((t: string) => t.toLowerCase()) : [];
const isProductPage =
    lowerTags.length > 0 &&
    (lowerTags.includes("products") ||
        lowerTags.includes("bathtubs") ||
        lowerTags.includes("showers") ||
        lowerTags.includes("cabinets"));

// 安全获取图片 URL
const imageUrl = image && image.src.startsWith("http")
    ? image.src
    : (image ? Astro.url.origin + image.src : Astro.url.origin);

// 🌟 核心逻辑：动态判断生成哪种 Schema
let finalSchema = {};

if (isProductPage) {
    // 如果是产品页，生成 Product Schema
    finalSchema = getProductSchema({ ...post.data, id: post.id }, Astro.url.origin);
} else {
    // 如果是普通博客，生成 BlogPosting Schema
    finalSchema = getBlogPostingSchema(
        {
            title,
            description,
            url: Astro.url.href,
            imageUrl,
            imageAlt: imageAlt || title,
            publishedTime: date ? date.toISOString() : new Date().toISOString(),
            modifiedTime: date ? date.toISOString() : new Date().toISOString(),
            author: author || "XC Bath",
        },
        Astro.url.origin,
    );
}
---

<BaseLayout title={title} description={description} heroImage={image}>
    <!-- 🌟 将 finalSchema 注入到 head 中 -->
    <script
        slot="schema"
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(finalSchema)}
    />

    <div class={`blog-container ${isProductPage ? "product-page-layout" : ""}`}>
        <div class="blog-wrapper-inner">
            <section class="main-content">
                <article class="blog-article">
                    <header class="blog-header">
                        <h1 class="blog-h1">{title}</h1>
                        <div class="blog-authorGroup">
                            <picture class="blog-author-img">
                                {
                                    !author ||
                                    author.toLowerCase().trim() ===
                                        "xc bath" ? (
                                        <Image
                                            src={xcBathAvatar}
                                            alt="XC Bath Team"
                                            width="32"
                                            height="32"
                                            style={{
                                                borderRadius: "50%",
                                                objectFit: "cover",
                                            }}
                                        />
                                    ) : (
                                        <Icon
                                            name="profile"
                                            width="32"
                                            height="32"
                                        />
                                    )
                                }
                            </picture>
                            <span class="blog-author">{author || "XC Bath"}</span>
                            <span aria-hidden="true" class="blog-dot"></span>
                            <span class="blog-date">{date ? formatDate(date) : ""}</span>
                        </div>
                    </header>

                    {image && (
                        <picture class="blog-mainImage">
                            <Image
                                src={image}
                                alt={imageAlt || title}
                                width="795"
                                height="400"
                                decoding="async"
                            />
                        </picture>
                    )}

                    <div class="blog-sidebar_widget-wrapper cs-hide-on-desktop">
                        <TableOfContents headings={headings} levels={3} />
                    </div>
                    <div id="blog-content">
                        <Content />
                    </div>

                    <!-- 🌟 新增：客户评价展示区 -->
                    {isProductPage && reviews && reviews.length > 0 && (
                        <div class="product-reviews-section">
                            <h2>Customer Reviews</h2>
                            <div class="reviews-list">
                                {reviews.map((review) => {
                                    // 自动提取姓名首字母 (例如 "Michael Smith" -> "MS")
                                    const initials = review.author
                                        .split(' ')
                                        .filter(Boolean)
                                        .map((n: string) => n[0])
                                        .join('')
                                        .substring(0, 2)
                                        .toUpperCase();

                                    return (
                                        <div class="review-card">
                                            <div class="review-header">
                                                <div class="review-author-info">
                                                    <div class="review-avatar">{initials}</div>
                                                    <div class="review-meta">
                                                        <strong>{review.author}</strong>
                                                        <span class="review-date">{review.date}</span>
                                                    </div>
                                                </div>
                                                <div class="review-stars">
                                                    {Array.from({ length: 5 }).map((_, i) => (
                                                        <Icon name={i < review.rating ? "ph:star-fill" : "ph:star"} class="star-icon" />
                                                    ))}
                                                </div>
                                            </div>
                                            <p class="review-content">"{review.content}"</p>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    )}

                </article>
            </section>

            <aside class="blog-sidebar">
                <div
                    class="blog-sidebar_widget-wrapper cs-hide-on-mobile"
                    id="desktop-toc"
                >
                    <TableOfContents headings={headings} levels={3} />
                </div>

                {
                    isProductPage && (
                        <div class="product-inquiry-box-inserted">
                            <div class="product-inquiry-box">
                                <h3>Interested in this Product?</h3>
                                <p>
                                    Get instant factory-direct pricing, custom
                                    specifications, and product catalogs for
                                    your projects.
                                </p>
                                <a
                                    href="/contact/#cs-form"
                                    class="product-inquiry-btn"
                                >
                                    INQUIRE NOW ➔
                                </a>
                            </div>
                        </div>
                    )
                }

                <div class="blog-sidebar_widget-wrapper">
                    <FeaturedProduct />
                </div>
            </aside>
        </div>
    </div>

    <CTA />
    <ImageLightbox />
</BaseLayout>

<style lang="less" is:global>
    /* ==========================================================================
       1. Mobile Base Styles (0em+)
       ========================================================================== */
    .blog-container {
        width: 94%;
        max-width: (1120/16em);
        margin: auto;
        padding: clamp(60px, 7vw, 100px) 0;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .blog-wrapper-inner {
        width: 100%;
        display: flex;
        flex-direction: column;
        row-gap: (50/16em);
    }

    .main-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .blog-article {
        width: 100%;
        max-width: (795/16em);
        display: block;

        .blog-header {
            margin-block: clamp(24px, 4vw, 40px);
        }

        .blog-mainImage {
            width: 100%;
            height: clamp(200px, 30vw, 400px);
            margin-bottom: (50/16em);
            border-radius: (8/16em);
            display: block;
            position: relative;
            overflow: hidden;

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                position: absolute;
                top: 0;
                left: 0;
            }
        }

        .blog-author-img {
            width: (32/16em);
            height: (32/16em);
            border-radius: 50%;
            display: block;
            position: relative;
            overflow: hidden;

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                position: absolute;
                top: 0;
                left: 0;
            }
        }

        .blog-authorGroup {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            gap: (12/16rem);
        }

        .blog-author,
        .blog-date {
            font-size: (14/16rem);
            line-height: 1.5em;
            color: var(--bodyTextColor);
        }

        .blog-dot {
            width: 3px;
            height: 3px;
            background-color: #fe4f70;
            border-radius: 50%;
            display: block;
        }

        .blog-h1 {
            font-size: clamp(18px, 4vw, 31px);
            font-weight: 800;
            line-height: 1.25em;
            width: 100% !important;
            max-width: 100% !important;
            margin: (12/16rem) 0;
            color: var(--headerColor);
            word-wrap: break-word;
        }

        #blog-content {
            margin-top: (16/16em);
            padding-top: (25/16em);
            border-top: 1px solid #a2a0a0;
        }
    }

    /* ==========================================================================
       2. Tablet/Desktop Styles (64em+ / 1024px+)
       ========================================================================== */
    @media only screen and (min-width: 64em) {
        .blog-wrapper-inner {
            flex-direction: row;
            align-items: flex-start;
            column-gap: (48/16em);
        }

        .product-page-layout {
            .blog-wrapper-inner {
                column-gap: (32/16em);
            }
            .main-content {
                flex: 1;
                width: auto;
            }
            .blog-article {
                max-width: 100% !important;
                width: 100% !important;
            }
            .blog-sidebar {
                width: (320/16em);
                min-width: (320/16em);
            }
        }
    }

    /* ==========================================================================
       3. Inquiry Box Styles - 询盘反馈框独立平铺
       ========================================================================== */
    .product-inquiry-box-inserted {
        margin-top: 24px;
        width: 100%;
        box-sizing: border-box;
    }

    .product-inquiry-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 24px;
        border-left: 4px solid #004B87;
        box-sizing: border-box;

        h3 {
            font-size: 16px;
            font-weight: 700;
            color: #004B87;
            margin: 0 0 10px 0;
        }

        p {
            font-size: 13px;
            line-height: 1.5;
            color: #64748b;
            margin: 0 0 18px 0;
        }

        .product-inquiry-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 12px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            text-decoration: none;
            border-radius: 4px;
            transition: background-color 0.3s ease, color 0.3s ease;
            background-color: #004B87 !important; 
            color: #ffffff !important; 
        }

        .product-inquiry-btn:hover {
            background-color: #C5A059 !important;
            color: #ffffff !important;
        }
    }

    /* ==========================================================================
       4. 🌟 评价模块样式
       ========================================================================== */
    .product-reviews-section {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px dashed #e5e7eb;

        h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--headerColor);
            margin-bottom: 1.5rem;
        }

        .reviews-list {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .review-card {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 1.25rem;
            
            .review-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 0.75rem;

                .review-author-info {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    
                    .review-avatar {
                        width: 2.75rem;
                        height: 2.75rem;
                        background-color: #2b5a41;
                        color: #ffffff;
                        font-size: 1rem;
                        font-weight: 700;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        border-radius: 50%;
                        flex-shrink: 0;
                    }

                    .review-meta {
                        display: flex;
                        flex-direction: column;
                        gap: 0.15rem;
                    }
                    
                    strong { font-size: 0.95rem; color: #111827; }
                    .review-date { font-size: 0.8rem; color: #6b7280; }
                }

                .review-stars {
                    display: flex;
                    color: #facc15;
                    margin-top: 0.5rem;
                    
                    .star-icon {
                        width: 1rem;
                        height: 1rem;
                    }
                }
            }

            .review-content {
                font-size: 0.9rem;
                line-height: 1.6;
                color: #374151;
                margin: 0;
                font-style: italic;
            }
        }
    }

    /* ==========================================================================
       5. Dark Mode Styles
       ========================================================================== */
    body.dark-mode {
        .blog-article {
            .blog-h1,
            .blog-author,
            .blog-date {
                color: #f7f7f7;
            }
            .blog-author-img {
                border-color: #333333;
                background-color: #1a1a1a;
            }
            #blog-content {
                border-top-color: #333333;
            }
        }
        
        .product-inquiry-box {
            background: #1a1a1a;
            border-color: #333333;
            border-left-color: #004B87; 
            h3 {
                color: #ffffff;
            }
            p {
                color: #999999;
            }
            .product-inquiry-btn {
                background-color: #004B87 !important;
                color: #ffffff !important;
            }
            .product-inquiry-btn:hover {
                background-color: #C5A059 !important;
                color: #ffffff !important;
            }
        }

        /* 评价模块暗黑模式 */
        .product-reviews-section {
            border-top-color: #374151;
            h2 { color: #f7f7f7; }
            .review-card {
                background: #1f2937;
                border-color: #374151;
                .review-header .review-author-info {
                    strong { color: #f3f4f6; }
                    .review-date { color: #9ca3af; }
                }
                .review-content { color: #d1d5db; }
            }
        }
    }

    /* Global Markdown Divider Override */
    #blog-content {
        hr {
            display: block !important;
            height: 1px !important;
            border: 0 !important;
            border-top: 1px solid #e5e7eb !important;
            margin-top: 30px !important;
            margin-bottom: 30px !important;
            padding: 0 !important;
            clear: both !important;
        }
    }

    /* 暗黑模式下的分割线 */
    body.dark-mode #blog-content hr {
        border-top-color: #333333 !important;
    }
</style>