---
// Utils
import { render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { formatDate } from "@js/utils";
import { getBlogPostingSchema } from "@js/blogPostingSchema.js";
import "@styles/markdown.less";

// 导入作者真实的头像图片
import xcBathAvatar from "@assets/images/authors/xcbath.png";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import FeaturedPost from "@components/FeaturedPost/FeaturedPost.astro";
import TableOfContents from "@components/TableOfContents/TableOfContents.astro";
import CTA from "@components/CTA/CTASimple.astro";

const { post } = Astro.props;
const { title, date, description, image, imageAlt, author, tags } = post.data;
const { Content, headings } = await render(post);

// 判断当前页面是不是产品页面
const isProductPage =
    tags &&
    (tags.includes("Products") ||
        tags.includes("Bathtubs") ||
        tags.includes("Showers") ||
        tags.includes("Cabinets"));

// Generate BlogPosting schema
const imageUrl = image.src.startsWith("http")
    ? image.src
    : Astro.url.origin + image.src;

const blogPostingSchema = getBlogPostingSchema(
    {
        title,
        description,
        url: Astro.url.href,
        imageUrl,
        imageAlt,
        publishedTime: date.toISOString(),
        modifiedTime: date.toISOString(),
        author,
    },
    Astro.url.origin,
);
---

<BaseLayout title={title} description={description} heroImage={image}>
    <script
        slot="schema"
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(blogPostingSchema)}
    />

    <!-- 🌟 修改点：如果是普通博文，则加上 is-blog-post 类名 -->
    <div class={`blog-container ${isProductPage ? "product-page-layout" : "is-blog-post"}`}>
        <div class="blog-wrapper-inner">
            <section class="main-content">
                <article class="blog-article">
                    <header class="blog-header">
                        <h1 class="blog-h1">{title}</h1>
                        <div class="blog-authorGroup">
                            <picture class="blog-author-img">
                                {
                                    !author ||
                                    author.toLowerCase().trim() ===
                                        "xc bath" ? (
                                        <Image
                                            src={xcBathAvatar}
                                            alt="XC Bath Team"
                                            width="36"
                                            height="36"
                                            style={{
                                                borderRadius: "50%",
                                                objectFit: "contain",
                                                padding: "4px",
                                                backgroundColor: "#f8fafc"
                                            }}
                                        />
                                    ) : (
                                        <Icon
                                            name="profile"
                                            width="32"
                                            height="32"
                                        />
                                    )
                                }
                            </picture>
                            <span class="blog-author">{author}</span>
                            <span aria-hidden="true" class="blog-dot"></span>
                            <span class="blog-date">{formatDate(date)}</span>
                        </div>
                    </header>

                    <picture class="blog-mainImage">
                        <Image
                            src={image}
                            alt={imageAlt}
                            width="795"
                            height="400"
                            decoding="async"
                        />
                    </picture>

                    <div class="blog-sidebar_widget-wrapper cs-hide-on-desktop">
                        <TableOfContents headings={headings} levels={3} />
                    </div>
                    <div id="blog-content">
                        <Content />
                    </div>
                </article>
            </section>

            <aside class="blog-sidebar">
                <div
                    class="blog-sidebar_widget-wrapper cs-hide-on-mobile"
                    id="desktop-toc"
                >
                    <TableOfContents headings={headings} levels={3} />
                </div>

                {
                    isProductPage && (
                        <div class="product-inquiry-box-inserted">
                            <div class="product-inquiry-box">
                                <h3>Interested in this Product?</h3>
                                <p>
                                    Get instant factory-direct pricing, custom
                                    specifications, and product catalogs for
                                    your projects.
                                </p>
                                <a
                                    href="/contact/#cs-form"
                                    class="product-inquiry-btn"
                                >
                                    INQUIRE NOW ➔
                                </a>
                            </div>
                        </div>
                    )
                }

                <div class="blog-sidebar_widget-wrapper">
                    <FeaturedPost />
                </div>
            </aside>
        </div>
    </div>

    <CTA />
</BaseLayout>

<style lang="less" is:global>
    /* ==========================================================================
       1. Mobile Base Styles (0em+) - 基础手机端样式与嵌套结构
       ========================================================================== */
    .blog-container {
        width: 94%;
        max-width: (1120/16em);
        margin: auto;
        padding: clamp(60px, 7vw, 100px) 0;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .blog-wrapper-inner {
        width: 100%;
        display: flex;
        flex-direction: column;
        row-gap: (50/16em);
    }

    .main-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .blog-article {
        width: 100%;
        max-width: (795/16em);
        display: block;

        .blog-header {
            margin-block: clamp(24px, 4vw, 40px);
        }

        .blog-mainImage {
            width: 100%;
            height: clamp(200px, 30vw, 400px);
            margin-bottom: (50/16em);
            border-radius: (8/16em);
            display: block;
            position: relative;
            overflow: hidden;

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                position: absolute;
                top: 0;
                left: 0;
            }
        }

        .blog-author-img {
            width: (36/16em); /* 微调：稍微放大了一点点到36px，更显眼 */
            height: (36/16em);
            border-radius: 50%;
            display: block;
            position: relative;
            overflow: hidden;
            border: 1px solid #e5e7eb; 
            background-color: #fff; /* 确保透明 PNG 的背景是白色的 */

            img {
                width: 100%;
                height: 100%;
                object-fit: contain; /* 修改：确保你的浴缸图标不变形，完整显示 */
                padding: 4px; /* 修改：给图标四周留一点空隙，避免贴边 */
                position: absolute;
                top: 0;
                left: 0;
            }
        }

        .blog-authorGroup {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            gap: (12/16rem);
        }

        .blog-author,
        .blog-date {
            font-size: (14/16rem);
            line-height: 1.5em;
            color: var(--bodyTextColor);
            font-weight: 500;
        }

        .blog-dot {
            width: 4px;
            height: 4px;
            background-color: #C5A059; /* 香槟金点缀 */
            border-radius: 50%;
            display: block;
        }

        .blog-h1 {
            font-size: clamp(18px, 4vw, 31px);
            font-weight: 800;
            line-height: 1.25em;
            width: 100% !important;
            max-width: 100% !important;
            margin: (12/16rem) 0;
            color: var(--headerColor);
            word-wrap: break-word;
        }

        #blog-content {
            margin-top: (16/16em);
            padding-top: (25/16em);
            border-top: 1px solid #a2a0a0;
        }
    }

    /* ==========================================================================
       2. Tablet/Desktop Styles (64em+ / 1024px+)
       ========================================================================== */
    @media only screen and (min-width: 64em) {
        .blog-wrapper-inner {
            flex-direction: row;
            align-items: flex-start;
            column-gap: (48/16em);
        }

        .product-page-layout {
            .blog-wrapper-inner {
                column-gap: (32/16em);
            }
            .main-content {
                flex: 1;
                width: auto;
            }
            .blog-article {
                max-width: 100% !important;
                width: 100% !important;
            }
            .blog-sidebar {
                width: (320/16em);
                min-width: (320/16em);
            }
        }
    }

    /* ==========================================================================
       3. Inquiry Box Styles - 询盘反馈框独立平铺
       ========================================================================== */
    .product-inquiry-box-inserted {
        margin-top: 24px;
        width: 100%;
        box-sizing: border-box;
    }

    .product-inquiry-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 24px;
        border-left: 4px solid #004B87; /* 品牌深海蓝 */
        box-sizing: border-box;

        h3 {
            font-size: 16px;
            font-weight: 700;
            color: #004B87;
            margin: 0 0 10px 0;
        }

        p {
            font-size: 13px;
            line-height: 1.5;
            color: #64748b;
            margin: 0 0 18px 0;
        }

        /* 按钮：深蓝底白字 */
        .product-inquiry-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 12px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            text-decoration: none;
            border-radius: 4px;
            transition: background-color 0.3s ease, color 0.3s ease;
            background-color: #004B87 !important; 
            color: #ffffff !important; 
        }

        .product-inquiry-btn:hover {
            background-color: #C5A059 !important; /* 悬停变香槟金 */
            color: #ffffff !important;
        }
    }

    /* ==========================================================================
       4. Dark Mode Styles - 暗黑模式独立平铺
       ========================================================================== */
    body.dark-mode {
        .blog-article {
            .blog-h1,
            .blog-author,
            .blog-date {
                color: #f7f7f7;
            }
            .blog-author-img {
                border-color: #333333;
                background-color: #1a1a1a; /* 深色模式下的头像背景 */
            }
        }
        
        .product-inquiry-box {
            background: #1a1a1a;
            border-color: #333333;
            border-left-color: #004B87; 
            h3 {
                color: #ffffff;
            }
            p {
                color: #999999;
            }
            .product-inquiry-btn {
                background-color: #004B87 !important;
                color: #ffffff !important;
            }
            .product-inquiry-btn:hover {
                background-color: #C5A059 !important;
                color: #ffffff !important;
            }
        }
    }

    /* ==========================================================================
       🌟 修改点：针对普通博文隐藏导航图标
       ========================================================================== */
    .is-blog-post {
        #desktop-toc {
            svg {
                display: none !important;
            }
            .cs-toc-link {
                gap: 0 !important;
            }
        }
    }

    /* Global Markdown Divider Override */
    #blog-content {
        :global(hr) {
            display: block !important;
            height: 1px !important;
            border: 0 !important;
            border-top: 1px solid #e5e7eb !important;
            margin-top: 30px !important;
            margin-bottom: 30px !important;
            padding: 0 !important;
            clear: both !important;
        }
    }
</style>