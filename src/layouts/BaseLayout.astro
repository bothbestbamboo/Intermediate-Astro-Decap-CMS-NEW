---
// Utils
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import type { GetImageResult } from "astro";
import "@styles/root.less";
import "@styles/dark.less";

// Components
import DynamicHeader from "@components/Header/DynamicHeader.astro";
import Footer from "@components/Footer/Footer.astro";
import Meta from "@components/Meta/Meta.astro";

// Data
import { SITE } from "@data/client";

// Create a union type for heroImage
type HeroImage = GetImageResult | ImageMetadata;

interface Props {
	title: string;
	description: string;
	heroImage?: HeroImage; 
}

const { description, title, heroImage } = Astro.props as Props;
---

<html lang={SITE.locale}>
	<head>
		<!-- View Transitions support -->
		<ClientRouter />

		<!-- 🌟 核心修复：将脚本放在 <head> 最前面，防止闪屏并确保切页保留状态 -->
		<script is:inline>
			// 主题初始化函数
			const initTheme = () => {
				let theme = localStorage.getItem("theme");
				
				// 如果没有本地记录，检查系统偏好
				if (!theme) {
					theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				}

				if (theme === "dark") {
					document.documentElement.classList.add("dark-mode");
					document.body.classList.add("dark-mode");
				} else {
					document.documentElement.classList.remove("dark-mode");
					document.body.classList.remove("dark-mode");
				}
			};

			// 1. 页面首次加载时立即执行
			initTheme();

			// 2. 监听 Astro 页面切换，在 DOM 准备后、绘制前强制重设，防止短暂闪白
			document.addEventListener("astro:before-swap", () => {
				// 在切页前确保 html 标签上也有主题类名
				if (localStorage.getItem("theme") === "dark") {
					document.documentElement.classList.add("dark-mode");
				}
			});
			
			// 3. 页面切换完成后（DOM 已替换），再次同步类名，防止被新页面覆盖
			document.addEventListener("astro:after-swap", () => {
				initTheme();
			});
		</script>

		<!-- SEO Meta Tags -->
		<Meta title={title} description={description} heroImage={heroImage}>
			<slot name="schema" slot="schema" />
		</Meta>

		<!-- Astro custom Font API -->
		<Font cssVariable="--font-primary" />

		<!-- If present, preloads the image passed as a prop -->
		{heroImage && <link rel="preload" href={heroImage.src} as="image" />}

		<!-- Sitewide Scripts -->
		<script src="@js/nav.js"></script>
	</head>
	<body>
		<!-- Screen reader skip main nav -->
		<a class="skip" aria-label="skip to main content" href="#main"
			>Click To Skip To Main Content</a
		>

		<DynamicHeader />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>