---
// Utils
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import type { GetImageResult } from "astro";
import "@styles/root.less";
import "@styles/dark.less";

// Components
import DynamicHeader from "@components/Header/DynamicHeader.astro";
import Footer from "@components/Footer/Footer.astro";
import Meta from "@components/Meta/Meta.astro";

// Data
import { SITE } from "@data/client";

// Create a union type for heroImage
type HeroImage = GetImageResult | ImageMetadata;

interface Props {
	title: string;
	description: string;
	heroImage?: HeroImage; 
}

const { description, title, heroImage } = Astro.props as Props;
---

<html lang={SITE.locale}>
	<head>
		<!-- View Transitions support -->
		<ClientRouter />

		<!-- 🌟 核心修复：将主题脚本放入 <head> 最前面，确保页面渲染前生效 -->
		<script is:inline>
			// 主题初始化函数
			const applyTheme = () => {
				const theme = localStorage.getItem("theme");
				// 如果本地存了 dark，或者没有存但系统偏好是 dark
				const isDark = theme === "dark" || (!theme && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
				
				if (isDark) {
					document.documentElement.classList.add("dark-mode");
					document.body.classList.add("dark-mode");
				} else {
					document.documentElement.classList.remove("dark-mode");
					document.body.classList.remove("dark-mode");
				}
			};

			// 1. 立即执行一次，防止首屏闪烁
			applyTheme();

			// 2. 监听 Astro 的页面切换事件
			// astro:before-swap 在旧 DOM 移除、新 DOM 插入前触发
			document.addEventListener("astro:before-swap", () => {
				// 强制给根节点加回 dark-mode 类，防止切换瞬间闪白
				if (localStorage.getItem("theme") === "dark") {
					document.documentElement.classList.add("dark-mode");
				}
			});
			
			// 3. astro:after-swap 在新页面 DOM 准备好后触发
			document.addEventListener("astro:after-swap", () => {
				applyTheme();
			});
		</script>

		<!-- SEO Meta Tags -->
		<Meta title={title} description={description} heroImage={heroImage}>
			<slot name="schema" slot="schema" />
		</Meta>

		<!-- Astro custom Font API -->
		<Font cssVariable="--font-primary" />

		<!-- If present, preloads the image passed as a prop -->
		{heroImage && <link rel="preload" href={heroImage.src} as="image" />}

		<!-- Sitewide Scripts -->
		<script src="@js/nav.js"></script>
	</head>
	<body>
		<!-- Screen reader skip main nav -->
		<a class="skip" aria-label="skip to main content" href="#main"
			>Click To Skip To Main Content</a
		>

		<DynamicHeader />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>