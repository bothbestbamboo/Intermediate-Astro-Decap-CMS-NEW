---
/**
 * * Custom layout displays blog posts and a sidebar
 **/

// Utils
import { Picture, Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { formatDate } from "@js/utils";

// 🌟 修改：导入你准备好的 XC Bath 头像
import xcBathAvatar from "@assets/images/authors/xcbath.png";

// Components
import FeaturedPost from "@components/FeaturedPost/FeaturedPost.astro";

const { posts } = Astro.props;
---

<section class="blog-container">
    <section class="main-content">
        {posts.length === 0 && <h1>No Recent Posts</h1>}
        {
            posts.length >= 1 &&
                posts.map((post) => (
                    <article class="recent-articles">
                        <Picture
                            pictureAttributes={{
                                class: "blog-mainImage",
                            }}
                            src={post.data.image}
                            quality={"mid"}
                            formats={["avif", "webp"]}
                            alt={post.data.imageAlt}
                            aria-hidden="true"
                        />

                        <div class="blog-header">
                            <div class="blog-authorGroup">
                                <picture class="blog-author-img">
                                    {/* 🌟 修改：直接强制渲染 XC Bath 的头像和名字 */}
                                    <Image 
                                        src={xcBathAvatar} 
                                        alt="XC Bath Team" 
                                        width="32" 
                                        height="32" 
                                        style={{ 
                                            borderRadius: '50%', 
                                            objectFit: 'contain', 
                                            padding: '2px',
                                            backgroundColor: '#fff'
                                        }}
                                    />
                                </picture>
                                <span class="blog-author">XC Bath</span>
                                <span aria-hidden="true" class="blog-dot" />
                                <span class="blog-date">{formatDate(post.data.date)}</span>
                            </div>
                            <h2 class="blog-h1">{post.data.title}</h2>
                            <p class="blog-desc">{post.data.description}</p>
                            <!-- 修复这里的链接为 /news/${post.id} -->
                            <a href={`/news/${post.id}`} class="blog-link">
                                Continue Reading
                            </a>
                        </div>
                    </article>
                ))
        }
    </section>
    <aside class="blog-sidebar">
        <div class="blog-sidebar_widget-wrapper">
            <FeaturedPost />
        </div>
    </aside>
</section>

<style lang="less">
	/* Mobile - 360px */
	@media only screen and (min-width: 0em) {
		.blog-link {
			font-size: (16/16rem);
			font-weight: 700;
			line-height: clamp(2.875em, 5.5vw, 3.5em);
			text-align: center;
			text-decoration: none;
			min-width: (150/16rem);
			margin: auto;
			box-sizing: border-box;
			padding: 0 (24/16rem);
			/* 👇 修改：强制白字深蓝底 */
			color: #ffffff !important; 
			background-color: #004B87 !important;
			border-radius: (4/16rem);
			display: inline-block;
			position: relative;
			z-index: 1;
			transition: all 0.3s;

			&:before {
				content: "";
				width: 100%;
				height: 100%;
				box-sizing: border-box;
				background: #C5A059 !important; /* 悬停变香槟金 */
				opacity: 0;
				border-radius: (4/16rem);
				position: absolute;
				top: 0;
				left: 0;
				z-index: -1;
				transition: all 0.3s;
			}

			&:hover {
				color: #ffffff !important;
				&:before {
					opacity: 1;
				}
			}

			&:focus-within {
				outline-offset: 5px;
			}
		}
	}

	/* Mobile - 360px */
	@media only screen and (min-width: 0em) {
		.blog-container {
			width: 94%;
			max-width: (1120/16em);
			margin: auto;
			padding: clamp(60px, 7vw, 100px) 0;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			row-gap: (50/16em);
			position: relative;
		}

		.main-content {
			width: 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			row-gap: (50/16em);
		}
	}

	/* Tablet - 1024px */
	@media only screen and (min-width: 64em) {
		.blog-container {
			flex-direction: row;
			align-items: flex-start;
			column-gap: (48/16em);
		}
	}

	/* Mobile - 360px */
	@media only screen and (min-width: 0em) {
		.recent-articles {
			width: 100%;
			max-width: (795/16em);
			flex: none;

			.blog-mainImage {
				width: 100%;
				height: clamp(200px, 30vw, 400px);
				border-radius: (8/16em) (8/16em) 0 0;
				display: block;
				position: relative;
				overflow: hidden;

				img {
					width: 100%;
					height: 100%;
					object-fit: cover;
					position: absolute;
					top: 0;
					left: 0;
				}
			}

			.blog-header {
				padding: clamp(30px, 5vw, 50px);
				border: 1px solid #ebebeb;
				border-radius: 0 0 (8/16em) (8/16em);
			}

			.blog-author-img {
				width: (36/16em); /* 调大一点点 */
				height: (36/16em);
				border-radius: 50%;
				display: block;
				position: relative;
				overflow: hidden;
				border: 1px solid #e5e7eb;

				img {
					width: 100%;
					height: 100%;
					object-fit: contain;
					position: absolute;
					top: 0;
					left: 0;
				}
			}

			.blog-authorGroup {
				display: flex;
				justify-content: flex-start;
				align-items: center;
				gap: (12/16rem);
			}

			.blog-author,
			.blog-date {
				font-size: (14/16rem);
				line-height: 1.5em;
				color: var(--bodyTextColor);
			}

			.blog-dot {
				width: 4px;
				height: 4px;
				background-color: #C5A059; /* 香槟金点缀 */
				border-radius: 50%;
				display: block;
			}

			.blog-h1 {
				font-size: clamp(20px, 5vw, 32px);
				font-weight: 700;
				line-height: 1.4em;
				margin: (16/16rem) 0;
				color: var(--headerColor);
			}

			.blog-desc {
				font-size: (16/16rem);
				line-height: 1.5em;
				margin: (16/16rem) 0 (32/16rem);
				color: var(--bodyTextColor);
			}
		}
	}

	/* Mobile - 1024px */
	@media only screen and (min-width: 64em) {
		.recent-articles {
			.blog-h1 {
				max-width: (500/16rem);
			}
		}
	}

	/* Dark Mode */
	@media only screen and (min-width: 0em) {
		body.dark-mode {
			.recent-articles {
				.blog-header {
					border-color: #333;
				}
				.blog-h1,
				.blog-desc,
				.blog-author,
				.blog-date {
					color: #f7f7f7;
				}
				.blog-author-img {
					border-color: #333;
					img {
						background-color: #1a1a1a;
					}
				}
			}

			.blog-sidebar_widget-h3,
			.blog-sidebar_widget-date,
			.blog-sidebar_widget-header {
				color: #f7f7f7;
			}
			.blog-sidebar_widget-header {
				&:after {
					background: var(--primary);
				}
			}
		}
	}
</style>