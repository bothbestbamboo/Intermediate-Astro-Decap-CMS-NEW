---
/**
 * * This layout uses a Recent Articles stitch to display blog posts
 **/

// Utils
import { Picture } from "astro:assets";
import { formatDate } from "@js/utils";

const { posts } = Astro.props;
---

<section id="blog-1144">
	<div class="cs-container">
		<div class="cs-content">
			<div class="cs-content-flex">
				<span class="cs-topper">News And Articles</span>
				<h2 class="cs-title">Directly from The Latest News and Articles</h2>
			</div>
		</div>
		<ul class="cs-card-group">
			{posts.length === 0 && <h1>No Recent Posts</h1>}
			{
				posts.length >= 1 &&
					posts.map((post) => (
						<li class="cs-item">
							<Picture
								pictureAttributes={{
									class: "cs-picture",
								}}
								src={post.data.image}
								quality={"mid"}
								formats={["avif", "webp"]}
								alt={post.data.imageAlt}
								aria-hidden="true"
							/>
							<div class="cs-flex">
								<span class="cs-date">{formatDate(post.data.date)}</span>
								<h3 class="cs-h3">{post.data.title}</h3>
								<p class="cs-item-text">{post.data.description}</p>
								<a href={`/news/${post.id}`} class="cs-link">
									Read More
									<!-- 内联极简 SVG 箭头 -->
									<svg class="cs-arrow" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
								</a>
							</div>
						</li>
					))
			}
		</ul>
	</div>
</section>

<style lang="less">
	#blog-1144 {
		padding: var(--sectionPadding);
		position: relative;
		z-index: 1;

		.cs-container {
			width: 100%;
			max-width: (784/16rem);
			margin: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: clamp(3rem, 6vw, 4rem);
		}

		.cs-content {
			text-align: left;
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
		}

		.cs-title {
			max-width: 20ch;
		}

		.cs-card-group {
			width: 100%;
			padding: 0;
			margin: 0;
			display: grid;
			grid-template-columns: repeat(12, 1fr);
			gap: (20/16rem);
		}

		.cs-item {
			text-align: left;
			list-style: none;
			border-radius: (16/16rem);
			overflow: hidden;
			background-color: #f7f7f7;
			border: 1px solid #e8e8e8;
			grid-column: span 12;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			position: relative;
			z-index: 1;
			transition: box-shadow 0.3s, transform 0.3s;

			&:hover {
				box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
				.cs-picture {
					img {
						opacity: 0.3;
						transform: scale(1.1);
					}
				}
			}
		}

		.cs-picture {
			width: 100%;
			height: (240/16rem);
			background-color: #1a1a1a;
			border-bottom: 4px solid #004B87; /* 品牌蓝边框 */
			overflow: hidden;
			display: block;
			flex: none;
			position: relative;
			z-index: 1;

			img {
				position: absolute;
				top: 0;
				left: 0;
				height: 100%;
				width: 100%;
				object-fit: cover;
				transition: transform 0.6s, opacity 0.3s;
			}
		}

		.cs-flex {
			height: 100%;
			padding: (24/16rem);
			box-sizing: border-box;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			position: relative;
			z-index: 2;
		}

		.cs-date {
			font-size: (14/16rem);
			line-height: 1.2em;
			font-weight: 700;
			text-align: inherit;
			margin: 0;
			padding: (8/16rem) (16/16rem);
			box-sizing: border-box;
			background-color: #004B87; /* 品牌蓝背景 */
			border-radius: (8/16rem) (8/16rem) 0 0;
			color: #fff;
			display: inline-block;
			position: absolute;
			left: (24/16rem);
			bottom: 100%;
			z-index: 2;
		}

		.cs-h3 {
			font-size: (20/16rem);
			text-align: inherit;
			line-height: 1.2em;
			font-weight: 700;
			color: var(--headerColor);
			margin: 0 0 (12/16rem) 0;
			transition: color 0.3s;
		}

		.cs-item-text {
			font-size: clamp(0.875rem, 1.5vw, 1rem);
			line-height: 1.5em;
			text-align: inherit;
			margin: 0 0 (20/16rem);
			color: var(--bodyTextColor);
		}

		.cs-link {
			font-size: (16/16rem);
			line-height: 1.2em;
			font-weight: 700;
			text-decoration: none;
			margin-top: auto;
			color: #004B87; /* 链接文字品牌蓝 */
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 6px;
			transition: color 0.3s ease;

			&:hover {
				color: #C5A059; /* 悬停香槟金 */
				.cs-arrow {
					transform: translateX(0.25rem);
				}
			}
		}

		.cs-arrow {
			width: (20/16rem);
			height: auto;
			transition: transform 0.3s;
			/* 移除了原版 filter，使 SVG 的 currentColor 能正常跟随文字变金色 */
		}
	}

	/* Tablet - 768px */
	@media only screen and (min-width: 48rem) {
		#blog-1144 {
			.cs-container {
				max-width: (1280/16rem);
			}

			.cs-content {
				text-align: left;
				flex-direction: row;
				justify-content: space-between;
				align-items: flex-end;
			}

			.cs-title {
				margin: 0;
			}

			.cs-item {
				grid-column: span 4;
			}
		}
	}

	/* Dark Mode */
	body.dark-mode {
		#blog-1144 {
			/* 删除了原有的 &:before 冗余遮罩，直接依赖全局 body 深色背景即可 */

			.cs-topper { 
				color: var(--primaryLight) !important; 
			}

			.cs-title, 
			.cs-text, 
			.cs-h3, 
			.cs-link, 
			.cs-item-text {
				color: var(--bodyTextColorWhite) !important;
			}

			.cs-text, 
			.cs-item-text { 
				opacity: 0.8; 
			}

			.cs-item {
				background-color: rgba(0, 0, 0, 0.2);
				border-color: rgba(255, 255, 255, 0.2);
			}

			.cs-picture { 
				border-color: #fff; 
			}

			.cs-date { 
				background-color: #fff; 
				color: #004B87 !important; 
			}

			/* 确保悬浮时链接文字和 SVG 箭头一起变金 */
			.cs-link:hover {
				color: #C5A059 !important;
			}
		}
	}
</style>