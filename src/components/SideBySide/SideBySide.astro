---
// SideBySide component from index.astro (#sbs section)

// Utils
import { Picture } from "astro:assets";

// Images
import cabinets2 from "@assets/images/services/cabinets2.jpg";
import construction from "@assets/images/services/construction.jpg";
---

<section id="sbs">
	<div class="cs-container">
		<!-- Left Image Section -->
		<div class="cs-left">
			<Picture src={cabinets2} alt="luxury whirlpool bathtub" width={522} formats={["avif", "webp"]} pictureAttributes={{ class: "cs-picture cs-picture1" }} priority />
			<Picture src={construction} alt="modern freestanding bathtub" width={390} formats={["avif", "webp"]} pictureAttributes={{ class: "cs-picture cs-picture2" }} priority />
		</div>
		<!-- Right Content Section-->
		<div class="cs-right">
			<span class="cs-topper">About Us</span>
			<h2 class="cs-title">About XC Bath</h2>
			
			<p class="cs-text">
				Established in 2009 and located in the Xuanzhou Intelligent Sanitary Ware Industrial Park, XC Bath is a modern high-tech enterprise occupying a 50-acre facility. We specialize in manufacturing premium freestanding bathtubs, whirlpools, and shower enclosures. With an annual production capacity of over 100,000 bathtubs and 80,000 shower enclosures, we are a leading manufacturer in the industry.
			</p>
			
			<p class="cs-text">
				Committed to manufacturing excellence, we continuously innovate to provide first-class products and services. Our dedication to quality is backed by our recognition as a National High-Tech Enterprise and our provincial-level Industrial Design Center, ensuring reliable and advanced solutions for global clients.
			</p>
			
			<div class="cs-flex-group">
				<p class="cs-flex-p">“We transform premium materials into high-performance bath solutions, delivering uncompromised manufacturing excellence and comfort to your projects.”</p>
				<span class="cs-name">Eddy Fong</span>
				<span class="cs-job">CEO-Founder</span>
				<img src="/assets/favicons/quote-white.svg" alt="quote icon" width="28" height="16" class="cs-quote-icon" aria-hidden="true">
			</div>
			<a href="/about/" class="cs-button-solid">More About Us</a>
		</div>
	</div>
</section>

<style lang="less">
	/*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

	#sbs {
		padding: var(--sectionPadding);

		.cs-container {
			width: 100%;
			max-width: (1280/16rem);
			margin: auto;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			row-gap: (40/16rem);
		}

		.cs-left {
			/* scaling the font size with the view width */
			font-size: ~"min(2.31vw, .7em)";
			/* using ems so we can use font size to scale the whole section */
			width: (631/16em);
			height: (636/16em);
			position: relative;
		}

		.cs-picture {
			border-radius: (24/16em);
			display: block;
			position: absolute;
			/* clips img tag corners */
			overflow: hidden;
			img {
				width: 100%;
				height: 100%;
				/* makes image act like a background image */
				object-fit: cover;
				position: absolute;
				top: 0;
				left: 0;
			}
		}

		.cs-picture1 {
			width: (522/16em);
			height: (581/16em);
			top: 0;
			left: 0;
		}

		.cs-picture2 {
			width: (414/16em);
			height: (400/16em);
			background-color: #fff;
			box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 40px;
			/* 6px - 12px */
			border: clamp(0.375em, 1.5vw, 0.75em) solid #fff;
			right: 0;
			bottom: 0;
		}

		.cs-right {
			max-width: (542/16rem);
			margin: auto;
			text-align: left; /* 统一左对齐，无需在下方子元素重复写 */
		}

		.cs-topper {
			margin-bottom: (4/16rem);
		}

		.cs-title {
			max-width: (800/16rem);
		}

		.cs-text {
			max-width: (750/16rem);
			margin-bottom: (16/16rem);

			&:last-of-type {
				margin-bottom: (32/16rem);
			}
		}

		.cs-flex-group {
			/* 16px - 32px */
			padding: clamp(1rem, 3vw, 2rem);
			background-color: #f7f7f7;
			border-radius: (16/16rem);
			position: relative;
		}

		.cs-flex-p {
			/* 14px - 16px */
			font-size: clamp(0.875rem, 1.5vw, 1rem);
			line-height: 1.5em;
			margin: 0 0 (16/16rem);
			color: #353535;
		}

		.cs-name {
			font-size: (16/16rem);
			font-weight: bold;
			line-height: 1.2em;
			text-transform: uppercase;
			margin: 0 0 (4/16rem);
			color: var(--headerColor);
			display: block;
		}

		.cs-job {
			font-size: (14/16rem);
			line-height: 1.5em;
			color: #353535;
			display: block;
		}

		.cs-quote-icon {
			/* 60px - 136px */
			width: clamp(3.75rem, 10vw, 8.5rem);
			height: auto;
			position: absolute;
			/* 16px - 32px */
			right: clamp(1rem, 4vw, 2rem);
			bottom: (0/16rem);
		}

		.cs-button-solid {
			margin-top: (32/16rem);
		}
	}

	/* Desktop - 1024px */
	@media only screen and (min-width: 64em) {
		#sbs {
			.cs-container {
				flex-flow: row;
				justify-content: space-between;
				gap: (52/16rem);
			}

			.cs-left {
				font-size: ~"min(1.2vw, 1em)";
				flex: none;
			}

			.cs-right {
				margin: 0;
			}
		}
	}

	/* Dark Mode */
	body.dark-mode {
		#sbs {
			.cs-picture2 {
				background-color: var(--dark);
				/* 6px - 12px */
				border: clamp(0.375em, 1.5vw, 0.75em) solid var(--dark);
			}

			.cs-topper {
				color: var(--primaryLight);
			}

			/* 强制覆盖主标题和段落的颜色，防止被其他样式干扰 */
			.cs-title,
			.cs-text {
				color: var(--bodyTextColorWhite) !important;
			}

			.cs-flex-group {
				background-color: var(--accent);
			}

			/* 引言文字 */
			.cs-flex-p {
				color: var(--bodyTextColorWhite) !important;
			}

			/* 人名 */
			.cs-name {
				color: var(--bodyTextColorWhite) !important;
			}

			/* 职位（稍微降低透明度以突出层级） */
			.cs-job {
				color: var(--bodyTextColorWhite) !important;
				opacity: 0.8;
			}

			.cs-quote-icon {
				opacity: 0.2;
			}
		}
	}
</style>