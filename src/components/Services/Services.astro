---
// 🌟 彻底移除所有容易导致 Vercel 报错或路径丢失的 Icon 导入
---

<section id="services" class="services">
  <div class="card">
    <picture>
      <a href="javascript:void(0);" rel="nofollow" style="cursor: default; display: inline-block;">
        <!-- 浴缸图标：带水龙头和底座的浴缸 -->
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="internal-service-svg">
          <path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3z"></path>
          <path d="M7 19v2M17 19v2"></path>
          <path d="M6 12V6a2 2 0 0 1 4 0"></path>
        </svg>
      </a>
    </picture>
    <h2>Bathtubs</h2>
    <p>
      Premium freestanding and whirlpool bathtubs crafted from high-quality acrylic. Designed for modern luxury bathrooms, our tubs offer exceptional durability, ergonomic comfort, and a sleek aesthetic to elevate any residential or commercial space.
    </p>
  </div>
  
  <div class="card">
    <picture>
      <a href="javascript:void(0);" rel="nofollow" style="cursor: default; display: inline-block;">
        <!-- 淋浴房图标：花洒与水滴 -->
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="internal-service-svg">
          <path d="M4 15h16"></path>
          <path d="M16 15v-6a4 4 0 0 0-8 0v2"></path>
          <path d="M11 15v4"></path>
          <path d="M13 15v4"></path>
        </svg>
      </a>
    </picture>
    <h2>Shower Enclosures</h2>
    <p>
      Frameless and semi-frameless shower enclosures engineered with premium tempered glass and corrosion-resistant hardware. Featuring superior waterproofing and easy-clean surfaces, they are perfect for contemporary bathrooms.
    </p>
  </div>
  
  <div class="card">
    <picture>
      <a href="javascript:void(0);" rel="nofollow" style="cursor: default; display: inline-block;">
        <!-- 浴室柜图标：带抽屉/双开门的洗手台柜 -->
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="internal-service-svg">
          <rect x="3" y="10" width="18" height="11" rx="1"></rect>
          <path d="M3 15h18"></path>
          <path d="M12 10v11"></path>
          <path d="M7 13h2"></path>
          <path d="M15 13h2"></path>
          <path d="M5 10V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6"></path>
        </svg>
      </a>
    </picture>
    <h2>Bath Cabinets</h2>
    <p>
      Elegant and highly functional bathroom vanities built with moisture-resistant materials and soft-close hardware. Offering smart storage solutions and customizable designs, they blend seamlessly into high-end residential and hospitality projects.
    </p>
  </div>
</section>

<style lang="less">
  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* ==========================================================================
     移动端优先基础样式 (Mobile 0em ~ 767px)
     ========================================================================== */
  @media only screen and (min-width: 0em) {
    .services {
      width: 90%;
      max-width: (1320/16em);
      margin: 0 auto;
      /* 🌟 核心修正：手机端彻底关闭往上的负边距！防止白色色块遮挡主图文字按钮 */
      margin-top: 20px !important; 
      margin-bottom: 40px;
      padding: 40px 20px;
      background: #ffffff;
      box-shadow: 0px 15px 35px rgba(0, 0, 0, 0.06);
      border-top: 6px solid var(--primary);
      border-radius: 8px;
      position: relative;
      z-index: 99;
      box-sizing: border-box;

      .card {
        width: 100%;
        max-width: 340px;
        margin: 0 auto 40px auto;
        display: flex;
        flex-direction: column;
        align-items: center; /* 强力居中 */
        box-sizing: border-box;

        &:last-of-type {
          margin-bottom: 0;
        }

        picture {
          width: 80px;
          height: 80px;
          margin: 0 auto 20px auto;
          background: var(--primary);
          border-radius: 50%;
          display: flex;
          justify-content: center;
          align-items: center;
          flex-shrink: 0;

          /* 🌟 赋予写死的内联 SVG 统一颜色与完美居中尺寸 */
          .internal-service-svg {
            width: 36px;
            height: 36px;
            color: #ffffff; /* 如果大底色是嫩绿，这里可以写#1a1a1a，若需要纯白则保留#ffffff */
          }
        }

        h2 {
          font-size: 24px; 
          font-weight: 700;
          line-height: 1.3; 
          text-align: center;
          margin: 0 0 12px 0;
          color: #1a1a1a;
          width: 100%;
        }

        p {
          font-size: 14px; 
          line-height: 1.5;
          text-align: center;
          width: 100%;
          opacity: 0.8;
          margin: 0;
          color: #4a4a4a;
        }
      }
    }
  }

  /* ==========================================================================
     平板端自适应布局 (Tablet 768px 及以上)
     ========================================================================== */
  @media only screen and (min-width: 768px) {
    .services {
      font-size: ~"min(1.8vw, 1em)";
      width: 96%;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      
      /* 🌟 只有在空间宽裕的大屏端，才允许往上提、形成盖在主图上的精美重叠层 */
      margin-top: (-140/16em) !important; 
      margin-bottom: (50/16em);

      .card {
        max-width: (325/16em);
        margin: 0;

        h2 {
          font-size: (28/16em); 
          line-height: 1.3;
        }
      }
    }
  }

  /* ==========================================================================
     宽屏电脑端样式 (Large Desktop 1300px 及以上)
     ========================================================================== */
  @media only screen and (min-width: 1300px) {
    .services {
      padding: (50/16em) (60/16em);
      margin-top: (-167/16em) !important; 

      .card {
        max-width: (357/16em);
        
        h2 {
          font-size: (32/16em);
        }
      }
    }
  }

  /* ==========================================================================
     暗黑模式完美兼容
     ========================================================================== */
  body.dark-mode {
    #services {
      background: var(--medium, #1a1a1a);

      picture {
        background: var(--primaryDark, #9dc815);
        .internal-service-svg {
          color: #111111;
        }
      }

      h2 {
        color: #ffffff;
      }
      p {
        color: #cccccc;
      }
    }
  }
</style>