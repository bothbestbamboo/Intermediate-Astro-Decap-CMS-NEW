---
/**
 * * DYNAMIC HEADER COMPONENT
 * * =======================
 * */

import { Icon } from "astro-icon/components";
import DarkModeToggle from "@components/DarkModeToggle/DarkModeToggle.astro";
---

<header id="cs-navigation">
	<div class="cs-container">
		<a href="/" class="cs-logo" aria-label="Return to Home page">
			<img
				src="/assets/favicons/logo-black.svg"
				alt="XC BATH - Premium Bathtub & Shower"
			/>
		</a>

		<nav class="cs-nav" aria-label="main navigation">
			<button
				class="cs-toggle"
				id="cs-toggle"
				aria-expanded="false"
				aria-controls="cs-ul-wrapper"
				aria-haspopup="menu"
				aria-label="mobile menu toggle"
			>
				<span class="cs-box" aria-hidden="true">
					<span class="cs-line cs-line1" aria-hidden="true"></span>
					<span class="cs-line cs-line2" aria-hidden="true"></span>
					<span class="cs-line cs-line3" aria-hidden="true"></span>
				</span>
			</button>

			<div class="cs-ul-wrapper" id="cs-ul-wrapper">
				<ul id="cs-expanded" class="cs-ul">
					<li class="cs-li">
						<a
							href="/"
							class:list={[
								"cs-li-link",
								{ "cs-active": Astro.url.pathname === "/" },
							]}
							aria-current={Astro.url.pathname === "/"
								? "page"
								: undefined}
						>
							Home
						</a>
					</li>

					<li class="cs-li">
						<a
							href="/about/"
							class:list={[
								"cs-li-link",
								{
									"cs-active":
										Astro.url.pathname === "/about/",
								},
							]}
							aria-current={Astro.url.pathname === "/about/"
								? "page"
								: undefined}
						>
							About
						</a>
					</li>

					<!-- Products 下拉菜单 -->
					<li class="cs-li cs-dropdown">
						<a
							href="/product/"
							class:list={[
								"cs-li-link cs-dropdown-toggle",
								{
									"cs-active":
										Astro.url.pathname.includes(
											"/product/",
										),
								},
							]}
							aria-haspopup="menu"
							aria-expanded="false"
							id="products-dropdown-toggle"
						>
							Products
							<Icon name="mdi--caret" class="cs-drop-icon" />
						</a>
						<ul
							class="cs-drop-ul cs-drop-card-style"
							aria-labelledby="products-dropdown-toggle"
						>
							<li class="cs-drop-li">
								<a href="/product/bathtubs/" class="cs-li-link cs-drop-link">
									<span class="cs-drop-title">Bathtubs</span>
									<span class="cs-drop-desc">Freestanding & Whirlpool</span>
								</a>
							</li>
							<li class="cs-drop-li">
								<a href="/product/showers/" class="cs-li-link cs-drop-link">
									<span class="cs-drop-title">Shower Enclosures</span>
									<span class="cs-drop-desc">Frameless & Tempered Glass</span>
								</a>
							</li>
							<li class="cs-drop-li">
								<a href="/product/cabinets/" class="cs-li-link cs-drop-link">
									<span class="cs-drop-title">Bath Cabinets</span>
									<span class="cs-drop-desc">Vanities & Storage</span>
								</a>
							</li>
						</ul>
					</li>

					<!-- Projects 下拉菜单 -->
					<li class="cs-li cs-dropdown">
						<button
							class:list={[
								"cs-li-link cs-dropdown-toggle",
								{
									"cs-active":
										Astro.url.pathname.includes(
											"/projects/",
										),
								},
							]}
							aria-haspopup="menu"
							aria-expanded="false"
							id="projects-dropdown-toggle"
						>
							Projects
							<Icon name="mdi--caret" class="cs-drop-icon" />
						</button>
						<ul
							class="cs-drop-ul cs-drop-card-style"
							aria-labelledby="projects-dropdown-toggle"
						>
							<li class="cs-drop-li">
								<a href="/projects/bathtubs/" class="cs-li-link cs-drop-link">
									<span class="cs-drop-title">Bathtub Projects</span>
									<span class="cs-drop-desc">Luxury Freestanding Tubs</span>
								</a>
							</li>
							<li class="cs-drop-li">
								<a href="/projects/showers/" class="cs-li-link cs-drop-link">
									<span class="cs-drop-title">Shower Projects</span>
									<span class="cs-drop-desc">Modern Glass Enclosures</span>
								</a>
							</li>
							<li class="cs-drop-li">
								<a href="/projects/cabinets/" class="cs-li-link cs-drop-link">
									<span class="cs-drop-title">Cabinet Projects</span>
									<span class="cs-drop-desc">Elegant Bathroom Vanities</span>
								</a>
							</li>
						</ul>
					</li>

					<li class="cs-li">
						<a
							href="/news/"
							class:list={[
								"cs-li-link",
								{
									"cs-active":
										Astro.url.pathname === "/news/",
								},
							]}
							aria-current={Astro.url.pathname === "/news/"
								? "page"
								: undefined}
						>
							Blog
						</a>
					</li>

					<li class="cs-li cs-hide-on-desktop">
						<a
							href="/contact/"
							class:list={[
								"cs-li-link",
								{
									"cs-active":
										Astro.url.pathname === "/contact/",
								},
							]}
							aria-current={Astro.url.pathname === "/contact/"
								? "page"
								: undefined}
						>
							Contact
						</a>
					</li>
				</ul>
			</div>
		</nav>

		<a href="/contact/" class="cs-button-solid cs-nav-button">Contact Us</a>
		<DarkModeToggle />
	</div>
</header>

<style lang="less">
	/*-- -------------------------- -->
	<---      Mobile Navigation     -->
	<--- -------------------------- -*/

	/* Mobile - 1023px */
	@media only screen and (max-width: 63.9375rem) {
		body {
			&.cs-open {
				overflow: hidden;
			}
		}

		#cs-navigation {
			width: 100%;
			box-sizing: border-box;
			padding: (12/16rem) (16/16rem);
			background-color: #fff;
			box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
			position: fixed;
			z-index: 10000;

			.cs-container {
				width: 100%;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.cs-logo {
				width: auto;
				max-width: 60%;
				height: (40/16rem);
				margin: 0;
				display: flex;
				justify-content: flex-start;
				align-items: center;
				z-index: 10;

				img {
					width: 100%;
					height: 100%;
					object-fit: contain;
					object-position: left;
				}
			}

			.cs-toggle {
				width: clamp(2.75rem, 6vw, 3rem);
				height: clamp(2.75rem, 6vw, 3rem);
				margin: 0 0 0 auto;
				background-color: transparent;
				border: none;
				display: flex;
				justify-content: center;
				align-items: center;
				cursor: pointer;
			}

			.cs-box {
				width: clamp(1.5rem, 2vw, 1.75rem);
				height: clamp(0.875rem, 1.5vw, 1rem);
				position: relative;
			}

			.cs-line {
				width: 100%;
				height: 2px;
				background-color: #1a1a1a;
				border-radius: 2px;
				position: absolute;
				left: 50%;
				transform: translateX(-50%);
				transition: transform 0.5s, top 0.3s, bottom 0.3s, opacity 0.3s;
			}

			.cs-line1 { top: 0; }
			.cs-line2 { top: 50%; transform: translateX(-50%) translateY(-50%); }
			.cs-line3 { bottom: 0; }

			.cs-active {
				.cs-line1 { top: 50%; transform: translate(-50%, -50%) rotate(225deg); }
				.cs-line2 { top: 50%; transform: translate(-50%, -50%) rotate(-225deg); transform-origin: center; }
				.cs-line3 { opacity: 0; bottom: 100%; }
			}

			.cs-ul-wrapper {
				height: 100vh;
				background-color: #fff;
				box-shadow: inset rgba(0, 0, 0, 0.2) 0px 8px 24px;
				opacity: 0;
				visibility: hidden;
				position: absolute;
				top: 100%;
				right: 0;
				z-index: 10;
				overflow: hidden;
				transform: scaleX(0);
				transition: transform 0.4s, opacity 0.3s;
				transform-origin: top right;
			}

			&.cs-active {
				.cs-ul-wrapper {
					opacity: 1;
					visibility: visible;
					transform: scaleX(1);
					transition-delay: 0.2s;
				}
				.cs-li {
					opacity: 1;
					transform: translateX(0);
				}
			}

			.cs-ul {
				width: auto;
				min-width: 40%;
				height: 65vh;
				margin: 0;
				padding: (48/16rem) clamp(1.75rem, 3vw, 2.5rem) (32/16rem) (70/16rem);
				display: flex;
				flex-direction: column;
				justify-content: flex-start;
				align-items: flex-end;
				gap: (20/16rem);
				overflow-y: auto;
			}

			.cs-li {
				text-align: right;
				list-style: none;
				width: 100%;
				margin-right: 0;
				opacity: 0;
				transform: translateX(-40/16rem);
				transition: transform 0.6s, opacity 0.9s;
			}

			.cs-li-link {
				font-size: clamp(1rem, 2.5vw, 1.5rem);
				color: var(--headerColor, #1a1a1a);
				line-height: 1.2em;
				text-decoration: none;
				margin: 0;
				display: inline-block;
				position: relative;
			}

			.cs-button-solid {
				display: none;
			}
		}
	}

	/* Dark Mode Mobile */
	@media only screen and (max-width: 63.9375rem) {
		body.dark-mode {
			#cs-navigation {
				background-color: var(--dark);
				.cs-logo { filter: grayscale(1) brightness(1000%); }
				.cs-line { background-color: #fff; }
				.cs-ul-wrapper { background-color: var(--medium); }
				.cs-li-link { color: var(--bodyTextColorWhite); }
			}
		}
	}

	/*-- -------------------------- -->
	<---     Navigation Dropdown    -->
	<--- -------------------------- -*/

	/* Mobile - 1023px */
	@media only screen and (max-width: 63.9375rem) {
		#cs-navigation {
			.cs-dropdown {
				color: var(--headerColor);
				position: relative;

				&.cs-active {
					.cs-drop-ul {
						height: auto;
						margin: (12/16rem) 0 0 0;
						padding: (16/16rem);
						opacity: 1;
						visibility: visible;
						transform: scale(1);
					}
					.cs-drop-link { opacity: 1; }
					.cs-drop-icon { transform: rotate(0); }
				}
				.cs-li-link {
					position: relative;
					transition: opacity 0.3s;
				}
			}

			.cs-drop-icon {
				width: (15/16rem);
				height: auto;
				display: inline-block;
				color: #C5A059;
				transform: rotate(180deg);
				transition: 0.3s;
			}

			.cs-drop-ul {
				width: 100%;
				height: 0;
				margin: 0;
				box-sizing: border-box;
				padding: 0 (24/16rem);
				background-color: var(--primary);
				opacity: 0;
				display: flex;
				visibility: hidden;
				flex-direction: column;
				justify-content: flex-start;
				align-items: flex-end;
				gap: (12/16rem);
				overflow: hidden;
				transform: scale(0);
				transition: padding 0.3s, margin 0.3s, height 0.3s, opacity 0.3s, transform 0.3s, visibility 0.3s;
				transform-origin: top right;
			}

			.cs-drop-li {
				text-align: inherit;
				list-style: none;
			}

			.cs-li-link {
				&.cs-drop-link {
					font-size: clamp(0.875rem, 2vw, 1.25rem);
					color: #fff;
					text-decoration: none;
				}
			}

			.cs-drop-title { display: block; font-weight: 600; }
			.cs-drop-desc { display: block; font-size: 0.75rem; opacity: 0.8; margin-top: 4px; }

			/* 统一定义下拉按钮外观，去除重复 */
			.cs-dropdown-toggle {
				background-color: transparent;
				border: none;
				appearance: none;
				font-family: inherit;
				cursor: pointer;
				padding: 0; 
				text-align: inherit;
			}
		}
	}

	/* Desktop - 1024px */
	@media only screen and (min-width: 64rem) {
		#cs-navigation {
			.cs-dropdown {
				position: relative;
				&:hover, &.cs-active {
					cursor: pointer;
					.cs-drop-ul { opacity: 1; visibility: visible; transform: scaleY(1); }
					.cs-drop-li { opacity: 1; transform: translateY(0); }
				}
			}

			.cs-dropdown:has(.cs-drop-icon) {
				display: flex;
				align-items: center;
				&:hover { .cs-drop-icon { transform: rotate(0); } }
			}

			.cs-drop-icon {
				width: (15/16rem);
				height: auto;
				display: inline-block;
				color: #C5A059;
				transform: rotate(180deg);
				transition: 0.3s;
			}

			.cs-drop-ul {
				margin: 0;
				background-color: #fff;
				box-shadow: rgba(149, 157, 165, 0.18) 0px 12px 32px;
				opacity: 0;
				visibility: hidden;
				position: absolute;
				top: 100%;
				left: 0;
				z-index: -100;
				overflow: hidden;
				transform: scaleY(0);
				transition: transform 0.3s, visibility 0.3s, opacity 0.3s;
				transform-origin: top;
				border-radius: 0 0 8px 8px;
			}

			.cs-drop-card-style {
				min-width: (270/16rem);
				padding: (10/16rem);
				border-bottom: 4px solid #C5A059;

				.cs-drop-li { margin-bottom: (6/16rem); &:last-child { margin-bottom: 0; } }
				.cs-drop-link {
					padding: (10/16rem) (14/16rem);
					border-radius: 6px;
					border-left: 3px solid transparent;
					&:hover { background-color: #f0f5fa; border-left-color: #C5A059; }
				}
			}

			.cs-drop-title { display: block; font-size: (15/16rem); font-weight: 700; color: var(--headerColor); line-height: 1.2em; }
			.cs-drop-desc { display: block; font-size: (12/16rem); color: #666; margin-top: (4/16rem); line-height: 1.2em; }
			.cs-drop-li { font-size: (15/16rem); list-style: none; width: 100%; height: auto; color: var(--bodyTextColor); opacity: 0; display: block; transform: translateY(-10/16rem); transition: opacity 0.4s, transform 0.4s; }
			.cs-li-link {
				&.cs-drop-link {
					font-size: (15/16rem); line-height: 1.4em; text-decoration: none; white-space: nowrap; width: 100%; box-sizing: border-box; color: var(--bodyTextColor); display: block; transition: color 0.2s, background-color 0.2s, border-color 0.2s;
					&:focus-within { outline: 2px solid currentColor; outline-offset: -2px; }
					&:before { display: none; }
				}
			}
			/* 桌面端下拉按钮保持统一样式 */
			.cs-dropdown-toggle { 
				background-color: transparent; 
				border: none; 
				appearance: none; 
				font-family: inherit; 
				cursor: pointer; 
				padding: 0;
			}
		}
	}

	/* Dark Mode Dropdown Desktop */
	@media only screen and (min-width: 0rem) {
		body.dark-mode {
			#cs-navigation {
				.cs-drop-ul { background-color: var(--dark); }
				.cs-drop-title { color: #fff; }
				.cs-drop-desc { color: #aaa; }
				.cs-li-link { &.cs-drop-link { &:hover { background-color: var(--medium); } } }
				.cs-drop-icon { color: #C5A059; filter: none; }
			}
		}
	}

	/*-- -------------------------- -->
	<---     Desktop Navigation     -->
	<--- -------------------------- -*/

	/* Small Desktop - 1024px */
	@media only screen and (min-width: 64rem) {
		#cs-navigation {
			width: 100%;
			box-sizing: border-box;
			padding: 0 (16/16rem);
			background-color: #fff;
			box-shadow: rgba(149, 157, 165, 0.1) 0px 8px 24px;
			position: fixed;
			z-index: 10000;

			.cs-container {
				width: 100%;
				max-width: (1280/16rem);
				margin: auto;
				display: flex;
				justify-content: flex-end;
				align-items: center;
				gap: (32/16rem);
			}

			.cs-toggle { display: none; }

			.cs-logo {
				flex: 1; 
				max-width: (400/16rem);
				height: (65/16rem);
				margin: 0 auto 0 0;
				padding: 0;
				display: flex;
				justify-content: flex-start;
				align-items: center;
				z-index: 100;

				img { width: 100%; height: 100%; object-fit: contain; object-position: left; }
			}

			.cs-ul { width: 100%; margin: 0; padding: 0; display: flex; justify-content: flex-start; align-items: center; gap: 0.25rem; }
			.cs-li { list-style: none; padding: (32/16rem) (16/16rem); flex: none; }

			.cs-li-link {
				font-size: clamp(0.875rem, 1vw, 1rem);
				line-height: 1.5em;
				text-decoration: none;
				margin: 0;
				color: var(--bodyTextColor);
				display: block;
				position: relative;

				&:hover { &:before { width: 100%; } }
				&.cs-active { &:before { width: 100%; } }

				&:before {
					content: "";
					width: 0%;
					height: 2px;
					background: #C5A059;
					opacity: 1;
					display: block;
					position: absolute;
					bottom: (0/16rem);
					left: 0;
					transition: width 0.3s;
				}
			}

			.cs-nav-button {
				background-color: var(--primary) !important;
				color: #ffffff !important;
				padding: (12/16rem) (24/16rem);
				border-radius: 4px;
				text-decoration: none;
				font-weight: 600;
				transition: background-color 0.3s;
				display: flex;
				align-items: center;
				justify-content: center;
				&:hover { background-color: #003366 !important; }
			}
		}
	}

	/* Dark Mode Global Desktop */
	@media only screen and (min-width: 64rem) {
		body.dark-mode {
			#cs-navigation {
				background-color: var(--dark);
				.cs-logo { filter: grayscale(1) brightness(1000%); }
				.cs-li-link {
					color: var(--bodyTextColorWhite);
					&:before { background-color: #C5A059; }
				}
			}
		}
	}
</style>