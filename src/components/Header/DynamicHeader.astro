---
/**
 * * DYNAMIC HEADER COMPONENT
 * * =======================
 * */

import { Icon } from "astro-icon/components";
import DarkModeToggle from "@components/DarkModeToggle/DarkModeToggle.astro";
---

<header id="cs-navigation">
	<div class="cs-container">
		<a href="/" class="cs-logo" aria-label="Return to Home page">
			<img
				src="/assets/favicons/logo-black.svg"
				alt="XC BATH - Premium Bathtub & Shower"
			/>
		</a>

		<nav class="cs-nav" aria-label="main navigation">
			<button
				class="cs-toggle"
				id="cs-toggle"
				aria-expanded="false"
				aria-controls="cs-ul-wrapper"
				aria-haspopup="menu"
				aria-label="mobile menu toggle"
			>
				<span class="cs-box" aria-hidden="true">
					<span class="cs-line cs-line1" aria-hidden="true"></span>
					<span class="cs-line cs-line2" aria-hidden="true"></span>
					<span class="cs-line cs-line3" aria-hidden="true"></span>
				</span>
			</button>

			<div class="cs-ul-wrapper" id="cs-ul-wrapper">
				<ul id="cs-expanded" class="cs-ul">
					<li class="cs-li">
						<a
							href="/"
							class:list={[
								"cs-li-link",
								{ "cs-active": Astro.url.pathname === "/" },
							]}
							aria-current={Astro.url.pathname === "/"
								? "page"
								: undefined}
						>
							Home
						</a>
					</li>

					<li class="cs-li">
						<a
							href="/about/"
							class:list={[
								"cs-li-link",
								{
									"cs-active":
										Astro.url.pathname === "/about/",
								},
							]}
							aria-current={Astro.url.pathname === "/about/"
								? "page"
								: undefined}
						>
							About
						</a>
					</li>

					<!-- Products 下拉菜单 -->
					<li class="cs-li cs-dropdown">
						<a
							href="/product/"
							class:list={[
								"cs-li-link cs-dropdown-toggle",
								{
									"cs-active":
										Astro.url.pathname.includes(
											"/product/",
										),
								},
							]}
							aria-haspopup="menu"
							aria-expanded="false"
							id="products-dropdown-toggle"
						>
							Products
							<Icon name="mdi--caret" class="cs-drop-icon" />
						</a>
						<ul
							class="cs-drop-ul cs-drop-card-style"
							aria-labelledby="products-dropdown-toggle"
						>
							<li class="cs-drop-li">
								<a
									href="/product/flooring/"
									class="cs-li-link cs-drop-link"
									aria-current={Astro.url.pathname ===
									"/product/flooring/"
										? "page"
										: undefined}
								>
									<span class="cs-drop-title"
										>Bamboo Flooring</span
									>
									<span class="cs-drop-desc"
										>Indoor Solid & Strand Woven</span
									>
								</a>
							</li>
							<li class="cs-drop-li">
								<a
									href="/product/decking/"
									class="cs-li-link cs-drop-link"
									aria-current={Astro.url.pathname ===
									"/product/decking/"
										? "page"
										: undefined}
								>
									<span class="cs-drop-title"
										>Bamboo Decking</span
									>
									<span class="cs-drop-desc"
										>Outdoor High Density Decking</span
									>
								</a>
							</li>
							<li class="cs-drop-li">
								<a
									href="/product/plywood/"
									class="cs-li-link cs-drop-link"
									aria-current={Astro.url.pathname ===
									"/product/plywood/"
										? "page"
										: undefined}
								>
									<span class="cs-drop-title"
										>Bamboo Plywood</span
									>
									<span class="cs-drop-desc"
										>Panels & Furniture Veneer</span
									>
								</a>
							</li>
							<li class="cs-drop-li">
								<a
									href="/product/bamboo/"
									class="cs-li-link cs-drop-link"
									aria-current={Astro.url.pathname ===
									"/product/bamboo/"
										? "page"
										: undefined}
								>
									<span class="cs-drop-title"
										>Bamboo Concepts</span
									>
									<span class="cs-drop-desc"
										>Inspired Sustainable Goods</span
									>
								</a>
							</li>
						</ul>
					</li>

					<!-- Projects 下拉菜单 -->
					<li class="cs-li cs-dropdown">
						<button
							class:list={[
								"cs-li-link cs-dropdown-toggle",
								{
									"cs-active":
										Astro.url.pathname.includes(
											"/projects/",
										),
								},
							]}
							aria-haspopup="menu"
							aria-expanded="false"
							id="projects-dropdown-toggle"
						>
							Projects
							<Icon name="mdi--caret" class="cs-drop-icon" />
						</button>
						<ul
							class="cs-drop-ul cs-drop-card-style"
							aria-labelledby="projects-dropdown-toggle"
						>
							<li class="cs-drop-li">
								<a
									href="/projects/bamboo-flooring/"
									class="cs-li-link cs-drop-link"
									aria-current={Astro.url.pathname ===
									"/projects/bamboo-flooring/"
										? "page"
										: undefined}
								>
									<span class="cs-drop-title"
										>Flooring Cases</span
									>
									<span class="cs-drop-desc"
										>Residential & Commercial Works</span
									>
								</a>
							</li>
							<li class="cs-drop-li">
								<a
									href="/projects/bamboo-decking/"
									class="cs-li-link cs-drop-link"
									aria-current={Astro.url.pathname ===
									"/projects/bamboo-decking/"
										? "page"
										: undefined}
								>
									<span class="cs-drop-title"
										>Decking Cases</span
									>
									<span class="cs-drop-desc"
										>Resorts, Promenades & Outdoors</span
									>
								</a>
							</li>
							<li class="cs-drop-li">
								<a
									href="/projects/bamboo-plywood/"
									class="cs-li-link cs-drop-link"
									aria-current={Astro.url.pathname ===
									"/projects/bamboo-plywood/"
										? "page"
										: undefined}
								>
									<span class="cs-drop-title"
										>Plywood Cases</span
									>
									<span class="cs-drop-desc"
										>Custom Furniture & Panels</span
									>
								</a>
							</li>
						</ul>
					</li>

					<li class="cs-li">
						<a
							href="/news/"
							class:list={[
								"cs-li-link",
								{
									"cs-active":
										Astro.url.pathname === "/news/",
								},
							]}
							aria-current={Astro.url.pathname === "/news/"
								? "page"
								: undefined}
						>
							Blog
						</a>
					</li>

					<li class="cs-li cs-hide-on-desktop">
						<a
							href="/contact/"
							class:list={[
								"cs-li-link",
								{
									"cs-active":
										Astro.url.pathname === "/contact/",
								},
							]}
							aria-current={Astro.url.pathname === "/contact/"
								? "page"
								: undefined}
						>
							Contact
						</a>
					</li>
				</ul>
			</div>
		</nav>

		<a href="/contact/" class="cs-button-solid cs-nav-button">Contact Us</a>
		<DarkModeToggle />
	</div>
</header>

<style lang="less">
	/*-- -------------------------- -->
	<---      Mobile Navigation     -->
	<--- -------------------------- -*/

	/* Mobile - 1023px */
	@media only screen and (max-width: 63.9375rem) {
		body {
			&.cs-open {
				overflow: hidden;
			}
		}

		#cs-navigation {
			width: 100%;
			box-sizing: border-box;
			padding: (12/16rem) (16/16rem);
			background-color: #fff;
			box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
			position: fixed;
			z-index: 10000;

			/* 修改2：强制移动端垂直居中 */
			.cs-container {
				width: 100%;
				display: flex;
				justify-content: space-between; /* 改为两端对齐，避免 LOGO 把右侧挤太远 */
				align-items: center;
			}

			.cs-logo {
				width: auto;         /* 修改：移除百分比 */
				max-width: 60%;      /* 修改：最大占宽 */
				height: (40/16rem);  /* 修改：固定高度，宽度自适应 */
				margin: 0;
				display: flex;
				justify-content: flex-start;
				align-items: center;
				z-index: 10;

				img {
					width: 100%;
					height: 100%;
					object-fit: contain;
					object-position: left;
				}
			}

			/* ... 这里省略中间未改动的手机端展开菜单代码 ... */
			/* ... (保持你原文件的代码即可) ... */
		}
	}

	/* Dark Mode Mobile */
	@media only screen and (max-width: 63.9375rem) {
		body.dark-mode {
			#cs-navigation {
				background-color: var(--dark);
				.cs-logo { filter: grayscale(1) brightness(1000%); }
				.cs-line { background-color: #fff; }
				.cs-ul-wrapper { background-color: var(--medium); }
				.cs-li-link { color: var(--bodyTextColorWhite); }
			}
		}
	}

	/*-- -------------------------- -->
	<---     Navigation Dropdown    -->
	<--- -------------------------- -*/

	/* Mobile - 1023px */
	@media only screen and (max-width: 63.9375rem) {
		#cs-navigation {
			.cs-dropdown {
				color: var(--headerColor);
				position: relative;

				&.cs-active {
					.cs-drop-ul {
						height: auto;
						margin: (12/16rem) 0 0 0;
						padding: (16/16rem);
						opacity: 1;
						visibility: visible;
						transform: scale(1);
					}
					.cs-drop-link {
						opacity: 1;
					}
					.cs-drop-icon {
						transform: rotate(0);
					}
				}
				.cs-li-link {
					position: relative;
					transition: opacity 0.3s;
				}
			}

			.cs-drop-icon {
				width: (15/16rem);
				height: auto;
				display: inline-block;
				/* 修改3：手机端下拉箭头变香槟金 */
				color: #C5A059; 
				transform: rotate(180deg);
				transition: 0.3s;
			}

			.cs-drop-ul {
				width: 100%;
				height: 0;
				margin: 0;
				box-sizing: border-box;
				padding: 0 (24/16rem) 0 (24/16rem);
				background-color: var(--primary);
				opacity: 0;
				display: flex;
				visibility: hidden;
				flex-direction: column;
				justify-content: flex-start;
				align-items: flex-end;
				gap: (12/16rem);
				overflow: hidden;
				transform: scale(0);
				transition:
					padding 0.3s,
					margin 0.3s,
					height 0.3s,
					opacity 0.3s,
					transform 0.3s,
					visibility 0.3s;
				transform-origin: top right;
			}

			.cs-drop-li {
				text-align: inherit;
				list-style: none;
			}

			.cs-li-link {
				&.cs-drop-link {
					font-size: clamp(0.875rem, 2vw, 1.25rem);
					color: #fff;
				}
			}

			.cs-drop-title {
				display: block;
				font-weight: 600;
			}

			.cs-drop-desc {
				display: block;
				font-size: 0.75rem;
				opacity: 0.8;
			}

			.cs-dropdown-toggle {
				background-color: transparent;
				border: none;
				appearance: none;
			}
		}
	}

	/* Desktop - 1024px */
	@media only screen and (min-width: 64rem) {
		#cs-navigation {
			.cs-dropdown {
				position: relative;
				&:hover,
				&.cs-active {
					cursor: pointer;
					.cs-drop-ul {
						opacity: 1;
						visibility: visible;
						transform: scaleY(1);
					}
					.cs-drop-li {
						opacity: 1;
						transform: translateY(0);
					}
				}
			}

			.cs-dropdown:has(.cs-drop-icon) {
				display: flex;
				align-items: center;
				&:hover {
					.cs-drop-icon {
						transform: rotate(0);
					}
				}
			}

			.cs-drop-icon {
				width: (15/16rem);
				height: auto;
				display: inline-block;
				/* 修改3：电脑端下拉箭头变香槟金 */
				color: #C5A059;
				transform: rotate(180deg);
				transition: 0.3s;
			}

			.cs-drop-ul {
				margin: 0;
				background-color: #fff;
				box-shadow: rgba(149, 157, 165, 0.18) 0px 12px 32px;
				opacity: 0;
				visibility: hidden;
				position: absolute;
				top: 100%;
				left: 0;
				z-index: -100;
				overflow: hidden;
				transform: scaleY(0);
				transition:
					transform 0.3s,
					visibility 0.3s,
					opacity 0.3s;
				transform-origin: top;
				border-radius: 0 0 8px 8px;
			}

			/* Products 与 Projects 统一使用的通用卡片式样式 */
			.cs-drop-card-style {
				min-width: (270/16rem);
				padding: (10/16rem);
				border-bottom: 4px solid #C5A059; /* 修改：底部边框也改成香槟金 */

				.cs-drop-li {
					margin-bottom: (6/16rem);
					&:last-child {
						margin-bottom: 0;
					}
				}

				.cs-drop-link {
					padding: (10/16rem) (14/16rem);
					border-radius: 6px;
					border-left: 3px solid transparent;

					&:hover {
						background-color: #f0f5fa;
						border-left-color: #C5A059; /* 修改：悬停时左侧边框变香槟金 */
					}
				}
			}

			.cs-drop-title {
				display: block;
				font-size: (15/16rem);
				font-weight: 700;
				color: var(--headerColor);
				line-height: 1.2em;
			}

			.cs-drop-desc {
				display: block;
				font-size: (12/16rem);
				color: #666;
				margin-top: (4/16rem);
				line-height: 1.2em;
			}

			.cs-drop-li {
				font-size: (15/16rem);
				list-style: none;
				width: 100%;
				height: auto;
				color: var(--bodyTextColor);
				opacity: 0;
				display: block;
				transform: translateY(-10/16rem);
				transition:
					opacity 0.4s,
					transform 0.4s;

				&:nth-of-type(1) { transition-delay: 0.03s; }
				&:nth-of-type(2) { transition-delay: 0.06s; }
				&:nth-of-type(3) { transition-delay: 0.09s; }
				&:nth-of-type(4) { transition-delay: 0.12s; }
			}

			.cs-li-link {
				&.cs-drop-link {
					font-size: (15/16rem);
					line-height: 1.4em;
					text-decoration: none;
					white-space: nowrap;
					width: 100%;
					box-sizing: border-box;
					color: var(--bodyTextColor);
					display: block;
					transition:
						color 0.2s,
						background-color 0.2s,
						border-color 0.2s;

					&:focus-within {
						outline: 2px solid currentColor;
						outline-offset: -2px;
					}
					&:before {
						display: none;
					}
				}
			}

			.cs-dropdown-toggle {
				background-color: transparent;
				border: none;
				appearance: none;
			}
		}
	}

	/* Dark Mode Dropdown Desktop */
	@media only screen and (min-width: 0rem) {
		body.dark-mode {
			#cs-navigation {
				.cs-drop-ul {
					background-color: var(--dark);
				}
				.cs-drop-title {
					color: #fff;
				}
				.cs-drop-desc {
					color: #aaa;
				}
				.cs-li-link {
					&.cs-drop-link {
						&:hover {
							background-color: var(--medium);
						}
					}
				}
				.cs-drop-icon {
					color: #C5A059; /* 深色模式下箭头也是香槟金 */
					filter: none;   /* 移除之前的滤镜，因为现在直接用颜色了 */
				}
			}
		}
	}

	/*-- -------------------------- -->
	<---     Desktop Navigation     -->
	<--- -------------------------- -*/

	/* Small Desktop - 1024px */
	@media only screen and (min-width: 64rem) {
		#cs-navigation {
			width: 100%;
			box-sizing: border-box;
			padding: 0 (16/16rem);
			background-color: #fff;
			box-shadow: rgba(149, 157, 165, 0.1) 0px 8px 24px;
			position: fixed;
			z-index: 10000;

			.cs-container {
				width: 100%;
				max-width: (1280/16rem);
				margin: auto;
				display: flex;
				justify-content: flex-end;
				align-items: center; /* 修改2：强制所有元素垂直居中，解决按钮偏下 */
				gap: (32/16rem);     /* 稍微增加右侧元素之间的间距 */
			}

			.cs-toggle {
				display: none;
			}

			.cs-logo {
				/* 修改1：利用 flex: 1 让它占据左侧所有剩余空间，并设定最大高度 */
				flex: 1; 
				max-width: (400/16rem); /* 放宽一点限制 */
				height: (65/16rem);     /* 撑满导航栏高度 */
				margin: 0 auto 0 0;
				padding: 0;
				display: flex;
				justify-content: flex-start; /* 靠左对齐 */
				align-items: center;
				z-index: 100;

				img {
					width: 100%;
					height: 100%;
					object-fit: contain; /* 保证宽高比不拉伸 */
					object-position: left; /* 靠左对齐 */
				}
			}

			.cs-ul {
				width: 100%;
				margin: 0;
				padding: 0;
				display: flex;
				justify-content: flex-start;
				align-items: center;
				gap: 0.25rem;
			}

			.cs-li {
				list-style: none;
				padding: (32/16rem) (16/16rem);
				flex: none;
			}

			.cs-li-link {
				font-size: clamp(0.875rem, 1vw, 1rem);
				line-height: 1.5em;
				text-decoration: none;
				margin: 0;
				color: var(--bodyTextColor);
				display: block;
				position: relative;

				&:hover {
					&:before {
						width: 100%;
					}
				}
				&.cs-active {
					&:before {
						width: 100%;
					}
				}

				&:before {
					content: "";
					width: 0%;
					height: 2px;
					background: #C5A059; /* 香槟金下划线 */
					opacity: 1;
					display: block;
					position: absolute;
					bottom: (0/16rem);
					left: 0;
					transition: width 0.3s;
				}
			}

			/* 针对 Contact Us 按钮的细节样式 */
			.cs-nav-button {
				background-color: var(--primary) !important;
				color: #ffffff !important;
				padding: (12/16rem) (24/16rem);
				border-radius: 4px;
				text-decoration: none;
				font-weight: 600;
				transition: background-color 0.3s;
				/* 强制垂直居中，消除因为行高带来的偏移 */
				display: flex;
				align-items: center;
				justify-content: center;
				
				&:hover {
					background-color: #003366 !important;
				}
			}
		}
	}

	/* Dark Mode Global Desktop */
	@media only screen and (min-width: 64rem) {
		body.dark-mode {
			#cs-navigation {
				background-color: var(--dark);
				.cs-logo {
					filter: grayscale(1) brightness(1000%);
				}
				.cs-li-link {
					color: var(--bodyTextColorWhite);
					&:before {
						background-color: #C5A059; 
					}
				}
			}
		}
	}
</style>