---
/**
 * * Simplified Full-Width CTA Component for Bamboo Business
 **/

// Utils
import { Picture } from "astro:assets";

// Images
import ctaImage from "@assets/images/CTA/bamboo-decking-project.jpg";
---

<section id="cta">
	<div class="container">
		<h2 class="title">
			Build Your Next Project
			<br />
			With Us Today
		</h2>
		<p>Partner with a trusted manufacturer to bring premium, sustainable bamboo solutions to your business. Reach out now to discuss custom dimensions, bulk pricing, or to request free material samples for your next residential or commercial project.</p>
		<a href="/contact/" class="cs-button-solid">👉 GET A FREE QUOTE NOW</a>
	</div>
	<Picture src={ctaImage} alt="Bamboo Flooring Samples" layout="full-width" formats={["avif", "webp"]} pictureAttributes={{ class: "cs-picture" }} />
</section>

<style lang="less">
	/* Mobile & Universal Styles */
	@media only screen and (min-width: 0em) {
		#cta {
			padding: (80/16rem) 0;
			position: relative;
			width: 100%;
			overflow: hidden;

			/* Dark Overlay for better readability */
			&:before {
				content: "";
				width: 100%;
				height: 100%;
				background: rgba(0, 0, 0, 0.45);
				display: block;
				position: absolute;
				top: 0;
				left: 0;
				z-index: 1;
			}

			.container {
				text-align: center;
				position: relative;
				z-index: 2;
				width: 90%;
				max-width: (1200/16rem);
				margin: auto;
			}

			.title {
				font-size: ~"min(9vw, 3.25rem)";
				font-weight: 900;
				line-height: 1.2;
				text-align: center;
				margin-bottom: (24/16rem);
				color: #fff;
				text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
			}

			p {
				text-align: center;
				width: 100%;
				max-width: (680/16rem);
				margin: 0 auto (36/16rem) auto;
				color: #f0f0f0;
				font-size: (18/16rem);
				line-height: 1.6;
				text-shadow: 0 1px 5px rgba(0, 0, 0, 0.4);
			}

			.cs-picture {
				width: 100%;
				height: 100%;
				position: absolute;
				top: 0;
				left: 0;
				z-index: 0;

				img {
					width: 100%;
					height: 100%;
					object-fit: cover;
					object-position: center;
				}
			}
		}
	}

	/* Small Desktop */
	@media only screen and (min-width: 64em) {
		#cta {
			padding: (120/16rem) 0;
		}
	}

	/* Large Desktop (Ensures 100% Full Width) */
	@media only screen and (min-width: 1300px) {
		#cta {
			padding: (140/16rem) 0;
			margin-top: (60/16rem);

			&:after {
				display: none;
			}

			.cs-picture {
				width: 100%;
				left: 0;
				transform: none;
			}
		}
	}

	/* Dark Mode */
	@media only screen and (min-width: 0em) {
		body.dark-mode {
			#cta {
				&:before {
					background: rgba(0, 0, 0, 0.6);
				}
			}
		}
	}
</style>