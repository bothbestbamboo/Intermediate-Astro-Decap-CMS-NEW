---
/**
 * * Simplified Full-Width CTA Component for XC Bath (Sanitary Ware Business)
 **/

// Utils
import { Picture } from "astro:assets";

// Styles (全局引入，避免每个页面重复注入内联样式)
import "@styles/cta.less";

// Images (建议后期替换为浴缸相关的图片)
import ctaImage from "@assets/images/CTA/bathroom-project.jpg";
---

<section id="cta">
	<div class="container">
		<h2 class="title">
			Build Your Next Project
			<br />
			With Us Today
		</h2>
		<p>Partner with a trusted sanitary ware manufacturer to bring premium bathtubs and shower enclosures to your business. Reach out now to discuss custom dimensions, bulk pricing, or to request product catalogs for your next residential or commercial project.</p>
		<a href="/contact/" class="cs-button-solid">GET A FREE QUOTE NOW</a>
	</div>
	<Picture src={ctaImage} alt="Luxury Outdoor Whirlpool Bathtub" layout="full-width" formats={["avif", "webp"]} pictureAttributes={{ class: "cs-picture" }} />
</section>