---
// Utils
import "@styles/sidebar.less";
import { Icon } from "astro-icon/components";

interface Heading {
	depth: number; // The heading level (h1 = 1, h2 = 2, etc)
	slug: string; // The ID of the heading for linking
	text: string; // The text content of the heading
}

interface Props {
	headings: Heading[]; // Array of headings from your markdown content
	levels?: 1 | 2 | 3; // How many levels of headers to show in TOC (default: 2)
}

const { headings, levels = 2 } = Astro.props as Props;

// Filter headings to only show up to the specified level
const filteredHeadings = headings.filter((heading) => heading.depth <= levels);

// 自定义函数：根据标题文本匹配对应的 Phosphor 图标
const getIconName = (text: string) => {
    const t = text.toLowerCase();
    
    // 浴缸产品页专属匹配
    if (t.includes("overview") || t.includes("philosophy")) return "ph:lightbulb";
    if (t.includes("technical") || t.includes("specification")) return "ph:gear";
    if (t.includes("advantage") || t.includes("craftsmanship")) return "ph:star";
    if (t.includes("manufacturing") || t.includes("process")) return "ph:factory";
    if (t.includes("detail") || t.includes("finishing")) return "ph:magnifying-glass";
    if (t.includes("application") || t.includes("environment")) return "ph:buildings";
    if (t.includes("packaging") || t.includes("ordering") || t.includes("bulk order")) return "ph:package";

    // 🌟 终极兜底：如果以上都没匹配上，显示一个干净的高级通用文档图标，绝不会突兀
    return "ph:file-text"; 
};
---

	<h3 class="blog-sidebar_widget-header">Quick Navigation</h3>
	<ul class="cs-toc-list">
		{
			filteredHeadings.map((heading) => (
				<li class={`cs-toc-item depth-${heading.depth}`}>
					<a href={`#${heading.slug}`} class="cs-toc-link">
                        <Icon name={getIconName(heading.text)} class="cs-toc-icon" width="16" height="16" />
						<span class="cs-toc-text">{heading.text}</span>
					</a>
				</li>
			))
		}
	</ul>

<style lang="less">
	.cs-toc-container {
		border-radius: 0.5em;
		border: 1px solid #ebebeb;
        padding: 2.1875em 1.875em;
        margin-bottom: 2rem;
	}

	.cs-toc-list {
		margin-top: 1rem;
		font-size: 0.875rem;
		display: flex;
		flex-direction: column;
		gap: 14px !important;
		list-style: none !important;
        padding-left: 0 !important;
	}

	.cs-toc-item {
		&.depth-2 {
			padding-left: 0.75rem !important;
		}
		&.depth-3 {
			padding-left: 1.5rem !important;
		}
		&:has(.cs-toc-current) {
			border-left: 2px solid var(--primaryLight) !important;
			color: var(--primaryLight);
            padding-left: calc(0.75rem - 2px) !important;
            &.depth-3 {
				padding-left: calc(1.5rem - 2px) !important;
			}
		}
	}

	.cs-toc-link {
		transition: all 0.2s ease-in-out;
		color: var(--bodyTextColor);
		text-decoration: none !important;
        
        /* 让图标和文字并排对齐 */
        display: flex !important;
        align-items: flex-start; 
        gap: 8px; 
        width: 100%;

        .cs-toc-text {
            flex: 1; 
            font-size: 14px !important;
            line-height: 1.4 !important;
            margin-top: 1px;
        }

		&.cs-toc-current {
			color: var(--primaryLight);
			.cs-toc-text {
                font-weight: 700 !important;
            }
            .cs-toc-icon {
                color: var(--primaryLight);
            }
		}
		&:hover {
			color: var(--primaryLight);
            .cs-toc-icon {
                color: var(--primaryLight);
            }
		}
	}

    .cs-toc-icon {
        color: #999; 
        flex-shrink: 0; 
        margin-top: 2px; 
        transition: color 0.2s ease-in-out;
    }

    /* ==========================================
       🌟 核心逻辑：针对普通博文隐藏图标（配合主模板的 .is-blog-post 类名）
       ========================================== */
    .is-blog-post {
        .cs-toc-icon {
            display: none !important; /* 直接隐藏图标 */
        }
        .cs-toc-link {
            gap: 0 !important; /* 取消图标和文字之间的间隙 */
        }
        .cs-toc-text {
            margin-top: 0 !important; /* 取消微调 */
        }
    }

    @media only screen and (min-width: 64rem) {
        .cs-toc-container {
            margin-bottom: 0;
        }
    }

    /* Dark Mode */
    @media only screen and (min-width: 0em) {
    body.dark-mode {
        .cs-toc-icon {
            color: #a3a3a3;
        }
        .cs-toc-link {
            color: #f7f7f7;
			&.cs-toc-current {
				color: var(--primaryLight);
                .cs-toc-icon {
                    color: var(--primaryLight);
                }
			}
			&:hover {
				opacity: 0.8;
			}
        }
    }
}
</style>

<script>
	// =========================================================================
	// 🌟 终极精准版 v2：增加点击锁定机制，彻底解决定位偏差导致的高亮回退
	// =========================================================================
	let isDesktop = window.matchMedia("(min-width: 1024px)").matches;
	let tocLinks: NodeListOf<HTMLAnchorElement>;
	let headerElements: HTMLElement[];
	let ticking = false;
	let isClickingTOC = false; // 点击锁定标志位
	let clickTimer: any;

	function updateTOC() {
		if (!isDesktop || !headerElements || headerElements.length === 0 || !tocLinks) return;
		// 如果用户刚刚点击了目录，跳过滚动监听，保持点击时的高亮
		if (isClickingTOC) return;

		const offset = 120; // 基准线：屏幕顶部往下 120px
		let currentId = headerElements[0].id;

		// 特判：如果已经滚动到页面最底部，直接高亮最后一个标题
		// （防止文章最后一段太短，滚不到基准线导致高亮卡在倒数第二个）
		if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 50) {
			currentId = headerElements[headerElements.length - 1].id;
		} else {
			for (let i = 0; i < headerElements.length; i++) {
				const el = headerElements[i];
				const rect = el.getBoundingClientRect();
				
				if (rect.top <= offset) {
					currentId = el.id;
				} else {
					break;
				}
			}
		}

		// 更新右侧目录的高亮状态
		tocLinks.forEach((link) => {
			link.classList.remove("cs-toc-current");
			if (link.getAttribute("href") === `#${currentId}`) {
				link.classList.add("cs-toc-current");
			}
		});
	}

	function initTOC() {
		if (!window.matchMedia("(min-width: 64rem)").matches) return;

		const wrappingElement = document.querySelector("#blog-content");
		const tocWrapper = document.querySelector("#desktop-toc");
		if (!wrappingElement || !tocWrapper) return;

		headerElements = Array.from(wrappingElement.querySelectorAll(":scope > h1, :scope > h2, :scope > h3"));
		tocLinks = tocWrapper.querySelectorAll(".cs-toc-link");

		if (headerElements.length === 0) return;

		// 1. 绑定滚动事件
		window.addEventListener("scroll", () => {
			if (!ticking) {
				window.requestAnimationFrame(() => {
					updateTOC();
					ticking = false;
				});
				ticking = true;
			}
		}, { passive: true });

		// 2. 绑定点击事件：加入锁定机制
		tocLinks.forEach(link => {
			link.addEventListener('click', () => {
				// 立刻高亮
				tocLinks.forEach(l => l.classList.remove("cs-toc-current"));
				link.classList.add("cs-toc-current");
				
				// 开启锁定，防止平滑滚动过程中的乱跳或定位不足导致的回退
				isClickingTOC = true;
				clearTimeout(clickTimer);
				clickTimer = setTimeout(() => {
					isClickingTOC = false;
					updateTOC(); // 解锁后重新计算一次准确位置
				}, 500); // 500ms 足够浏览器完成平滑滚动
			});
		});

		// 3. 处理初始加载 Hash
		const hash = window.location.hash;
		if (hash) {
			setTimeout(() => {
				const targetLink = document.querySelector(`#desktop-toc a[href="${hash}"]`) as HTMLAnchorElement;
				if (targetLink) {
					tocLinks.forEach(l => l.classList.remove("cs-toc-current"));
					targetLink.classList.add("cs-toc-current");
				}
			}, 150);
		} else {
			updateTOC();
		}
	}

	if (isDesktop) initTOC();

	document.addEventListener("astro:after-swap", () => {
		if (window.matchMedia("(min-width: 64rem)").matches) {
			isDesktop = true;
			initTOC();
		} else {
			isDesktop = false;
		}
	});

	window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
		isDesktop = e.matches;
		if (e.matches) {
			initTOC();
		}
	});
</script>