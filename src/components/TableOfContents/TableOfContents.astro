---
// Utils
import "@styles/sidebar.less";
import { Icon } from "astro-icon/components";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	levels?: 1 | 2 | 3;
	isProduct?: boolean; // 🌟 接收是否是产品页的判断
}

const { headings, levels = 2, isProduct = false } = Astro.props as Props;
const filteredHeadings = headings.filter((heading) => heading.depth <= levels);

const getIconName = (text: string) => {
    const t = text.toLowerCase();
    if (t.includes("overview") || t.includes("philosophy")) return "ph:lightbulb";
    if (t.includes("technical") || t.includes("specification")) return "ph:gear";
    if (t.includes("advantage") || t.includes("craftsmanship")) return "ph:star";
    if (t.includes("manufacturing") || t.includes("process")) return "ph:factory";
    if (t.includes("detail") || t.includes("finishing")) return "ph:magnifying-glass";
    if (t.includes("application") || t.includes("environment")) return "ph:buildings";
    if (t.includes("packaging") || t.includes("ordering") || t.includes("bulk order")) return "ph:package";
    if (t.includes("available profile") || t.includes("profile")) return "ph:layout";
    if (t.includes("safety") || t.includes("performance")) return "ph:shield-check";
    if (t.includes("physical") || t.includes("stability")) return "ph:scales";
    if (t.includes("installation")) return "ph:wrench";
    if (t.includes("gallery")) return "ph:images";
    if (t.includes("infuser") || t.includes("drinking")) return "ph:coffee";
    if (t.includes("customization") || t.includes("label") || t.includes("private")) return "ph:tag";
    if (t.includes("user experience") || t.includes("design")) return "ph:magic-wand";
    if (t.includes("care") || t.includes("recommendation") || t.includes("maintenance")) return "ph:info";
    return "ph:file-text";
};
---

<!-- 🌟 如果外层没有包裹卡片，组件就自己提供一个完美的卡片框 -->
<div class="cs-toc-wrapper">
	<h3 class="blog-sidebar_widget-header">Quick Navigation</h3>
	<ul class="cs-toc-list">
		{
			filteredHeadings.map((heading) => (
				<li class={`cs-toc-item depth-${heading.depth}`}>
					<a href={`#${heading.slug}`} class="cs-toc-link">
						{/* 只有产品页显示图标 */}
						{isProduct && (
							<Icon name={getIconName(heading.text)} class="cs-toc-icon" width="16" height="16" />
						)}
						<span class="cs-toc-text">{heading.text}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>

<style lang="less">
	/* 统一的精美卡片外框 */
	.cs-toc-wrapper {
		background: #ffffff;
		border: 1px solid #a2a0a0;
		border-radius: (8/16em);
		padding: 24px;
		width: 100%;
		box-sizing: border-box;

		body.dark-mode & {
			background: #1a1a1a;
			border-color: #333333;
		}
	}

	.blog-sidebar_widget-header {
		margin: 0 0 1.5rem 0 !important;
		font-size: 1.125rem !important;
		font-weight: 700 !important;
		color: #111 !important;
		text-align: center;
		
		&::after {
			content: "";
			width: 50px;
			height: 3px;
			margin: 16px auto 0;
			background: var(--primaryLight) !important; 
			border-radius: 4px;
			display: block;
			position: relative;
		}
	}

	.cs-toc-list {
		margin: 0 !important;
		padding: 0 !important;
		font-size: 0.875rem;
		display: flex;
		flex-direction: column;
		gap: 14px !important;
		list-style: none !important;
	}

	.cs-toc-item {
		display: block !important;
		margin: 0 !important;
		padding: 0 !important;
		position: relative;
		line-height: 1.4 !important;
		border-left: 2px solid transparent !important;
		padding-left: 8px !important; 
		
		&.depth-3 { padding-left: 20px !important; }
	}

	.cs-toc-link {
		display: flex !important;
		align-items: flex-start;
		gap: 8px; 
		line-height: 1.4 !important;
		margin: 0 !important;
		padding: 0 !important;
		color: #4b5563 !important; 
		text-decoration: none !important;
		word-break: break-word !important;
		transition: all 0.2s ease-in-out;
		width: 100%;

		.cs-toc-text {
			flex: 1;
			font-size: 14px !important;
			font-weight: 400 !important;
			line-height: 1.4 !important;
			display: block; 
		}

		&.cs-toc-current {
			color: var(--primaryLight) !important;
			.cs-toc-text { font-weight: 700 !important; }
			.cs-toc-icon { color: var(--primaryLight); }
		}
		&:hover {
			color: var(--primaryLight) !important;
			.cs-toc-icon { color: var(--primaryLight); }
		}
	}

	.cs-toc-icon {
		color: #999; 
		flex-shrink: 0; 
		margin-top: 2px; 
		transition: color 0.2s ease-in-out;
	}

	/* 如果隐藏了图标，修正间距 */
	.cs-toc-link:not(:has(.cs-toc-icon)) {
		gap: 0 !important;
	}

	body.dark-mode {
		.blog-sidebar_widget-header { color: #f7f7f7 !important; }
		.cs-toc-icon { color: #a3a3a3; }
		.cs-toc-link {
			color: #a2a0a0 !important;
			&.cs-toc-current { color: var(--primaryLight) !important; }
			&:hover { color: #ffffff !important; }
		}
	}
</style>

<script>
	let observeHeaderTags: IntersectionObserver;
	let allHeaderTags: NodeListOf<Element>;
	let isDesktop = window.matchMedia("(min-width: 1024px)").matches;

	function setCurrent(entries: any[]) {
		const tocWrapper = document.querySelector("#desktop-toc");
		if (!tocWrapper) return;
		const allSectionLinks = tocWrapper.querySelectorAll(".cs-toc-link");
		
		// 收集所有当前在视口内的标题
		const visibleEntries = entries.filter(e => e.isIntersecting);
		
		if (visibleEntries.length > 0) {
			// 🌟 终极修复：如果有多个标题同时进入判定区，只取最靠近屏幕顶部（y最小）的那一个！
			// 这彻底解决了因为图片高度不同或 #### 标题干扰导致的高亮跳跃。
			const topEntry = visibleEntries.reduce((prev, curr) => {
				return (prev.boundingClientRect.top < curr.boundingClientRect.top) ? prev : curr;
			});

			allSectionLinks.forEach((link) => link.classList.remove("cs-toc-current"));
			const targetLink = tocWrapper.querySelector(`a[href="#${topEntry.target.id}"].cs-toc-link`);
			if (targetLink) targetLink.classList.add("cs-toc-current");
		}
	}

	function initTOC() {
		if (!window.matchMedia("(min-width: 64rem)").matches) return;
		
		const wrappingElement = document.querySelector("#blog-content");
		if (!wrappingElement) return;
		
		// 只监听 h2 和 h3
		allHeaderTags = wrappingElement.querySelectorAll(":scope > h2, :scope > h3");
		if (!allHeaderTags.length) return;
		
		// 调整触发范围，确保精准捕获滚动到顶部的第一个元素
		let options = { 
			root: null, 
			rootMargin: "-10% 0px -60% 0px", // 稍微收紧了底部触发区
			threshold: 0 
		};
		
		observeHeaderTags = new IntersectionObserver(setCurrent, options);
		allHeaderTags.forEach((tag) => observeHeaderTags.observe(tag));
	}

	if (isDesktop) initTOC();
	
	document.addEventListener("astro:after-swap", () => {
		if (window.matchMedia("(min-width: 64rem)").matches) initTOC();
	});
	
	window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
		if (e.matches) initTOC();
		else if (observeHeaderTags) observeHeaderTags.disconnect();
	});
</script>