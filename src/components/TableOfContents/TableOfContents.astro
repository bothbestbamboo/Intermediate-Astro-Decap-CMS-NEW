---
// Utils
import "@styles/sidebar.less";
import { Icon } from "astro-icon/components";

interface Heading {
	depth: number; // The heading level (h1 = 1, h2 = 2, etc)
	slug: string; // The ID of the heading for linking
	text: string; // The text content of the heading
}

interface Props {
	headings: Heading[]; // Array of headings from your markdown content
	levels?: 1 | 2 | 3; // How many levels of headers to show in TOC (default: 2)
}

const { headings, levels = 2 } = Astro.props as Props;

// Filter headings to only show up to the specified level
const filteredHeadings = headings.filter(
    (heading) => heading.depth <= levels && heading.text && heading.text.trim() !== ""
);

// 自定义函数：根据标题文本匹配对应的 Phosphor 图标
const getIconName = (text: string) => {
    const t = text.toLowerCase();
    
    // 浴缸产品页专属匹配
    if (t.includes("overview") || t.includes("philosophy")) return "ph:lightbulb";
    if (t.includes("technical") || t.includes("specification")) return "ph:gear";
    if (t.includes("advantage") || t.includes("craftsmanship")) return "ph:star";
    if (t.includes("manufacturing") || t.includes("process")) return "ph:factory";
    if (t.includes("detail") || t.includes("finishing")) return "ph:magnifying-glass";
    if (t.includes("application") || t.includes("environment")) return "ph:buildings";
    if (t.includes("packaging") || t.includes("ordering") || t.includes("bulk order")) return "ph:package";

    // 🌟 终极兜底：如果以上都没匹配上，显示一个干净的高级通用文档图标，绝不会突兀
    return "ph:file-text"; 
};
---

	<h3 class="blog-sidebar_widget-header">Quick Navigation</h3>
	<ul class="cs-toc-list">
		{
			filteredHeadings.map((heading) => (
				<li class={`cs-toc-item depth-${heading.depth}`}>
					<a href={`#${heading.slug}`} class="cs-toc-link">
                        <Icon name={getIconName(heading.text)} class="cs-toc-icon" width="16" height="16" />
						<span class="cs-toc-text">{heading.text}</span>
					</a>
				</li>
			))
		}
	</ul>

<style lang="less">
	.cs-toc-container {
		border-radius: 0.5em;
		border: 1px solid #ebebeb;
        padding: 2.1875em 1.875em;
        margin-bottom: 2rem;
	}

	.cs-toc-list {
		margin-top: 1rem;
		font-size: 0.875rem;
		display: flex;
		flex-direction: column;
		gap: 14px !important;
		list-style: none !important;
        padding-left: 0 !important;
	}

	.cs-toc-item {
		position: relative;
		transition: all 0.2s ease;
		
		/* 层级缩进 */
		&.depth-2 { padding-left: 0 !important; }
		&.depth-3 { padding-left: 12px !important; } /* 3级标题缩进 */

		/* 🌟 统一辅助线 (默认隐藏) */
		&::before {
			content: "";
			position: absolute;
			left: 0; 
			top: 5px;
			bottom: 5px;
			width: 2px;
			background-color: var(--primaryLight, #9cc813); 
			border-radius: 2px;
			opacity: 0; 
			transition: all 0.2s ease;
		}

		/* 悬浮 或 当前高亮项 时显示辅助线 */
		&:hover::before,
		&:has(.cs-toc-current)::before {
			opacity: 1;
		}
	}

	.cs-toc-link {
		transition: all 0.2s ease-in-out;
		color: var(--bodyTextColor);
		text-decoration: none !important;
        
        /* 让图标和文字并排对齐 */
        display: flex !important;
        align-items: flex-start; 
        gap: 8px; 
        width: 100%;

        .cs-toc-text {
            flex: 1; 
            font-size: 14px !important;
            line-height: 1.4 !important;
            margin-top: 1px;
            transition: color 0.2s ease;
        }

		&.cs-toc-current {
			.cs-toc-text {
                font-weight: 700 !important;
            }
            .cs-toc-icon {
                color: var(--primaryLight);
            }
		}
		
		/* 🌟 全局悬浮颜色变绿 */
		&:hover {
            .cs-toc-text {
                color: var(--primaryLight) !important;
            }
            .cs-toc-icon {
                color: var(--primaryLight);
            }
		}
	}

    /* 3级标题文本小一点、灰一点 */
    .cs-toc-item.depth-3 .cs-toc-text {
        font-size: 13px !important; 
        color: #6b7280 !important; 
    }

    .cs-toc-icon {
        color: #999; 
        flex-shrink: 0; 
        margin-top: 2px; 
        transition: color 0.2s ease-in-out;
    }

    @media only screen and (min-width: 64rem) {
        .cs-toc-container {
            margin-bottom: 0;
        }
    }

    /* Dark Mode */
    @media only screen and (min-width: 0em) {
    body.dark-mode {
        .cs-toc-icon {
            color: #a3a3a3;
        }
        .cs-toc-link {
            color: #f7f7f7;
			&.cs-toc-current {
                .cs-toc-icon {
                    color: var(--primaryLight);
                }
			}
        }
        
        .cs-toc-item {
            &::before {
                background-color: var(--primaryLight, #aed52b);
            }
        }

        .cs-toc-item.depth-3 .cs-toc-text {
            color: #888 !important; 
        }
        
        .cs-toc-link:hover .cs-toc-text {
            color: var(--primaryLight) !important;
        }
    }
}
</style>

<script>
	let observeHeaderTags: IntersectionObserver;
	let allHeaderTags: NodeListOf<Element>;
	let isDesktop = window.matchMedia("(min-width: 1024px)").matches;
	// 🌟 维护一个当前可见的标题集合
	let visibleHeadings = new Set<Element>();

	function updateActiveLink() {
		const tocWrapper = document.querySelector("#desktop-toc");
		if (!tocWrapper) return;
		const allSectionLinks = tocWrapper.querySelectorAll(".cs-toc-link");
		
		if (visibleHeadings.size === 0) return;

		let currentActive = null;
		let maxTop = -Infinity;
		// 偏移量，需配合 markdown.less 里的 scroll-margin-top: 10rem (160px)
		const OFFSET = 170; 

		// 1. 寻找已经越过基准线且最靠下的元素（解决跳转高亮不生效）
		visibleHeadings.forEach((target) => {
			const rect = target.getBoundingClientRect();
			if (rect.top <= OFFSET) {
				if (rect.top > maxTop) {
					maxTop = rect.top;
					currentActive = target;
				}
			}
		});

		// 2. 如果所有可见元素都在基准线下方（刚进页面），选最靠上的
		if (!currentActive) {
			let minTop = Infinity;
			visibleHeadings.forEach((target) => {
				const rect = target.getBoundingClientRect();
				if (rect.top < minTop) {
					minTop = rect.top;
					currentActive = target;
				}
			});
		}

		if (currentActive) {
			allSectionLinks.forEach((link) => link.classList.remove("cs-toc-current"));
			const targetLink = tocWrapper.querySelector(`a[href="#${(currentActive as Element).id}"].cs-toc-link`);
			if (targetLink) targetLink.classList.add("cs-toc-current");
		}
	}

	function setCurrent(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				visibleHeadings.add(entry.target);
			} else {
				visibleHeadings.delete(entry.target);
			}
		});
		updateActiveLink();
	}

	function initTOC() {
		if (!window.matchMedia("(min-width: 64rem)").matches) return;
		
		const wrappingElement = document.querySelector("#blog-content");
		if (!wrappingElement) return;
		
		allHeaderTags = wrappingElement.querySelectorAll(":scope > h2, :scope > h3");
		if (!allHeaderTags.length) return;
		
		visibleHeadings.clear(); 

		if (observeHeaderTags) {
			observeHeaderTags.disconnect();
		}

		let options = { 
			root: null, 
			// 顶部留出 160px 避开固定 Header (与 scroll-margin-top 一致)
			rootMargin: "-160px 0px -50% 0px", 
			threshold: 0 
		};
		
		observeHeaderTags = new IntersectionObserver(setCurrent, options);
		allHeaderTags.forEach((tag) => observeHeaderTags.observe(tag));
	}

	if (isDesktop) initTOC();
	
	document.addEventListener("astro:after-swap", () => {
		if (window.matchMedia("(min-width: 64rem)").matches) initTOC();
	});
	
	window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
		if (e.matches) {
			initTOC();
		} else if (observeHeaderTags) {
			observeHeaderTags.disconnect();
		}
	});
</script>