---
// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import Gallery from "@components/Gallery/Gallery.astro";
import CTA from "@components/CTA/CTASimple.astro";

// Images
import landingImage from "@assets/images/gallery/bannerproduct.jpg";
const optimizedImage = await getImage({ src: landingImage, format: "webp" });
---

<BaseLayout title="Projects | Global Bathroom Solutions" description="Explore XC Bath's global portfolio of freestanding bathtubs, modern shower enclosures, and custom bathroom vanities for luxury hotels and residential projects." heroImage={optimizedImage}>
    <Banner 
        title="Global Excellence in Bathroom Solutions" 
        subtitle="Explore our verified portfolio of international commercial supply, luxury residential spaces, and custom sanitary ware installations." 
        image={optimizedImage} 
    />
    <Gallery />
    <CTA />
</BaseLayout>